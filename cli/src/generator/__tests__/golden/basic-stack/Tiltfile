#!/usr/bin/env starlark
# -*- coding: utf-8 -*-
# =============================================================================
# 🎯 basic-stack - TILT ENTRYPOINT
# =============================================================================
# SYSTEM-GENERATED BY TDK CLI - DO NOT EDIT
# Source: .tdk/project.json
# Regenerate with: tdk config regenerate
# =============================================================================

print("🚀 Loading basic-stack...")

# =============================================================================
# 📦 REGISTER TDK EXTENSION
# =============================================================================
# The TDK Tilt extension (engine, discovery, specs, ext) is vendored into
# this project at generation time (.tdk/.tdk-out/tdk-cli-ext). Resolution:
#   1. Vendored in-project copy (default - works offline, no GitHub needed)
#   2. $TDK_EXTENSION_PATH (explicit override to any tdk-cli checkout)
#   3. Clear failure with instructions (no endless git retry on a missing repo)
_vendored_tdk_path = config.main_dir + "/tdk-cli-ext"
_use_local = False
_local_tdk_path = ""

if str(local("test -d " + _vendored_tdk_path + " && echo yes || echo no", quiet=True, echo_off=True)).strip() == 'yes':
    _use_local = True
    _local_tdk_path = _vendored_tdk_path
else:
    _env_tdk_path = os.environ.get('TDK_EXTENSION_PATH', '')
    if len(_env_tdk_path) > 0 and str(local("test -d " + _env_tdk_path + " && echo yes || echo no", quiet=True, echo_off=True)).strip() == 'yes':
        _use_local = True
        _local_tdk_path = _env_tdk_path

if not _use_local:
    fail("""
TDK extension not found.

'tdk up' needs the TDK Tilt extension (engine/discovery/specs/ext).
Fix it with one of:
  1) Regenerate the project so the extension is vendored in:
       tdk config regenerate
     (set $TDK_EXTENSION_SOURCE to a tdk-cli checkout if it was not auto-detected)
  2) Point at any tdk-cli checkout:
       export TDK_EXTENSION_PATH=/path/to/tdk-cli
  3) Follow the sandbox guide: https://tdk-landscape.github.io/tdk-website/sandbox/
""")

v1alpha1.extension_repo(name='tdk-cli-local', url='file://' + _local_tdk_path)
v1alpha1.extension(name='tdk-cli', repo_name='tdk-cli-local', repo_path='')

# =============================================================================
# 📍 PROJECT CONFIGURATION
# =============================================================================
# Tiltfile is in .tdk/.tdk-out/, project root is two levels up
PROJECT_ROOT = config.main_dir + "/../.."
os.environ['TDK_PROJECT_ROOT'] = PROJECT_ROOT

# =============================================================================
# 🔌 LOAD MASTER CONFIGS & TDK MODULES
# =============================================================================
load("TILT_TECH_STACK.star",
'assert_tech_stack',
'TECH_STACK',
)
load("TILT_RESOURCE_DEFAULTS.star",
'BASE_PORT_FRONTEND',
'BASE_PORT_BACKEND',
)
load("spec.master",
'RESOURCE_DEFAULTS',
'PRE_ALPHA_RESOURCES',
'ALPHA_RESOURCES',
'BETA_RESOURCES',
'FOCUS_PRE_ALPHA',
'FOCUS_ALPHA',
'FOCUS_BETA',
)

# Load TDK extension modules
load('ext://tdk-cli',
'Utils',
'Manifest',
'Config',
'Orchestrator',
'Watchers',
'Infra',
'Docker',
'FrontendBuildPlan',
'load_ui_enhancements',
'APP_RESOURCES',
'GLOBAL_CONFIG_EXPORT',
'Registry',
'resource_defers_start',
)

# =============================================================================
# 🏗️ VALIDATE & INITIALIZE
# =============================================================================
assert_tech_stack({
    "bundler": TECH_STACK['bundler'],
    "runtime": TECH_STACK['runtime'],
    "orm": TECH_STACK['orm'],
    "messaging": TECH_STACK['messaging'],
})

# =============================================================================
# 🎨 UI ENHANCEMENTS
# =============================================================================
load_ui_enhancements({
'enable_tooltips': True,
'enable_icons': True,
'enable_help_panel': True,
'enable_cron_jobs_tab': True,
})

# =============================================================================
# 📋 PARSE CLI ARGUMENTS
# =============================================================================
config.define_string_list('focus', usage='Services to focus on')
config.define_bool('no-frontend', usage='Skip frontend services')
config.define_bool('include-monitoring', usage='Include monitoring stack')
config.define_string_list('verbose', usage='Verbose logging')
config.define_bool('no-auto-init-new', usage='Do not auto-init new services')

for resource_name in RESOURCE_DEFAULTS.keys():
    config.define_bool(resource_name, usage='Enable ' + resource_name)

config.define_string_list('args', args=True, usage='Positional arguments')
cfg = config.parse()

# =============================================================================
# 🔮 AUTO-DISCOVERY
# =============================================================================
_AUTO_DISCOVER_ENABLED = os.environ.get('AUTO_DISCOVER', 'true').lower() == 'true'
_DISCOVERY_SCAN_INTERVAL = int(os.environ.get('DISCOVERY_SCAN_INTERVAL', '5'))
_AUTO_INIT_NEW_RESOURCES = not cfg.get('no-auto-init-new', False)

# Auto-discovery enabled (s interval)
_AUTO_DISCOVER_ENABLED = _AUTO_DISCOVER_ENABLED

# =============================================================================
# 📝 LOGGING
# =============================================================================
_LOG_LEVEL = "verbose" if (cfg.get('verbose') or os.environ.get('VERBOSE', '').lower() == 'true') else "normal"

def get_log_level():
    return _LOG_LEVEL

def is_verbose():
    return _LOG_LEVEL == "verbose"

os.environ['TILT_LOG_LEVEL'] = _LOG_LEVEL
if _LOG_LEVEL == "verbose":
    os.environ['VERBOSE'] = 'true'

# =============================================================================
# 🌍 ENVIRONMENT SETUP
# =============================================================================
is_macos = str(local('uname -s', quiet=True)).strip() == 'Darwin'
Utils.load_dotenv(PROJECT_ROOT)

# =============================================================================
# 🎯 FOCUS MODE
# =============================================================================
FOCUS_MODE, FOCUS_ENABLED_ALL, FOCUS_ENABLED_RESOURCES = Config.apply_focus(cfg)
# Load ALWAYS_ENABLED_INFRA from project.json (falls back to defaults if not specified)
ALWAYS_ENABLED_INFRA = ["database-management", "proxy"]

def should_enable(resource_name):
    # Always-enabled infra (proxy/Traefik, verdaccio, database-management) must stay
    # enabled independent of focus mode: FOCUS_MODE collapses to False whenever the pre-alpha
    # stack bucket is empty (the default on a freshly generated project.json), which used to
    # silently disable Traefik and friends on every out-of-the-box `tdk up`.
    if resource_name in ALWAYS_ENABLED_INFRA:
        return RESOURCE_DEFAULTS.get(resource_name, True)
    if FOCUS_MODE and FOCUS_ENABLED_ALL:
        if resource_name in FOCUS_ENABLED_ALL:
            return True
        for domain in FOCUS_ENABLED_ALL:
            if resource_name.startswith(domain + "-"):
                return True
    return Utils.should_enable(resource_name, cfg, RESOURCE_DEFAULTS)

# =============================================================================
# 🏗️ INFRASTRUCTURE SERVICES
# =============================================================================

print("🏗️  Loading infrastructure services...")
# load_all returns the golden-layers build resource's name. It has to reach
# TILT_CONTEXT below: app and migrator resources add it to their resource_deps
# so their images build only after the base images exist. Dropping it lets
# every service image build start at once, fail with "pull access denied" on a
# machine that has no base images yet, and never retry.
GOLDEN_IMAGE_RESOURCE = Infra.load_all(
    should_enable=should_enable,
    fix_docker_networks_fn=Utils.fix_docker_networks,
    docker_provider=Docker,
    write_fn=Utils.write_file_if_changed,
    project_root=PROJECT_ROOT,
)

# =============================================================================
# 📚 INITIALIZE TDK
# =============================================================================
print("🚀 Initializing TDK...")

# Use pre-loaded APP_RESOURCES from TDK registry (already initialized with all services)
# Registry.reinitialize() is only needed if we want to force a fresh discovery
_app_resources_list = APP_RESOURCES

# First run or cache cleared — build registry from manifests
if len(_app_resources_list) == 0:
    _app_resources_list = Registry.reinitialize()

# If still empty, load directly from manifest files
if len(_app_resources_list) == 0:
    _app_resources_list = Manifest.load_all(PROJECT_ROOT)

print("📦 Loaded {} services".format(len(_app_resources_list)))

# Create Tilt resources for all services
TILT_CONTEXT = {
    'should_enable': should_enable,
    'write_file': Utils.write_file_if_changed,
    'global_config': GLOBAL_CONFIG_EXPORT,
    'project_root': PROJECT_ROOT,
    'all_services': _app_resources_list,
    'golden_image_resource': GOLDEN_IMAGE_RESOURCE,
    'focus_mode': FOCUS_MODE,
    'focus_enabled_resources': FOCUS_ENABLED_RESOURCES,
}

print("🚀 Creating Tilt resources for {} services...".format(len(_app_resources_list)))
for app_service in _app_resources_list:
    Orchestrator.apply_service(app_service, TILT_CONTEXT)

# Setup file watchers
Watchers.setup_package_json(_app_resources_list, should_enable)

# Apply focus mode filter
# Build known Tilt resource names (and a stack-name -> resource-name index) from
# discovered services to filter focus list. Focus targets are stack names (e.g.
# "app", "billing") from spec.master, which do NOT always match the resource
# name prefix (stack "app" maps to resources "dashboard-api"/"dashboard-app",
# not "app-*") - so stack membership must be resolved explicitly rather than
# assumed via string prefix.
_KNOWN_TILT_RESOURCES = set()
_DEFERRED_IMAGE_RESOURCES = set()
_KNOWN_TILT_RESOURCES.add('service-discovery-daemon')
_KNOWN_TILT_RESOURCES.add('init-networks')
_KNOWN_TILT_RESOURCES.add('postgres')
_KNOWN_TILT_RESOURCES.add('nats')
_KNOWN_TILT_RESOURCES.add('infisical')
_KNOWN_TILT_RESOURCES.add('infisical-db')
_KNOWN_TILT_RESOURCES.add('infisical-redis')
_KNOWN_TILT_RESOURCES.add('traefik')
_KNOWN_TILT_RESOURCES.add('verdaccio')
_KNOWN_TILT_RESOURCES.add('golden-layers-build')
_STACK_TO_RESOURCE_NAMES = {}
for _KNOWN_SVC in _app_resources_list:
    _KNOWN_SVC_NAME = _KNOWN_SVC.get('name', '')
    _KNOWN_SVC_STACK = _KNOWN_SVC.get('stack', '')
    if _KNOWN_SVC_NAME:
        for _KNOWN_RES in _KNOWN_SVC.get('resources', []):
            _KNOWN_RES_NAME = _KNOWN_RES.get('name', '')
            if _KNOWN_RES_NAME:
                _KNOWN_TILT_RESOURCES.add(_KNOWN_RES_NAME)
                _KNOWN_TILT_RESOURCES.add(_KNOWN_RES_NAME + '-run-only')
                _KNOWN_TILT_RESOURCES.add(_KNOWN_RES_NAME + '-config-gen')
                # A frontend whose build script is the standard `tsc && vite build` gets a
                # non-blocking <service>-typecheck resource (see Docker frontend registration).
                # Name it here, from the same plan and path, so focus mode can enable it.
                if _KNOWN_RES.get('frontend', False) and not should_enable('backends-only'):
                    _KNOWN_RES_DIR = PROJECT_ROOT + '/' + _KNOWN_RES.get('_resource_path', _KNOWN_SVC.get('path', '') + '/' + _KNOWN_RES_NAME)
                    if FrontendBuildPlan(_KNOWN_RES_DIR + '/package.json')['typecheck']:
                        _KNOWN_TILT_RESOURCES.add(_KNOWN_RES_NAME + '-typecheck')
                _KNOWN_RES_MANIFEST = _KNOWN_RES.get('_manifest', {})
                _KNOWN_RES_SABLIER = _KNOWN_RES_MANIFEST.get('sablier', {})
                # Mirrors _register_single_resource: the prebuild only exists for
                # a resource that gets a docker_build (has syncs, not a library/sdk/BYO).
                if resource_defers_start(_KNOWN_RES_MANIFEST) and _KNOWN_RES_MANIFEST.get('appType', 'backend') not in ['library', 'sdk', 'bring-your-own'] and _KNOWN_RES_MANIFEST.get('syncs'):
                    _DEFERRED_IMAGE_RESOURCES.add(_KNOWN_RES_NAME + '-image')
                if _KNOWN_SVC_STACK:
                    _STACK_TO_RESOURCE_NAMES.setdefault(_KNOWN_SVC_STACK, [])
                    _STACK_TO_RESOURCE_NAMES[_KNOWN_SVC_STACK].append(_KNOWN_RES_NAME)
if FOCUS_MODE and FOCUS_ENABLED_RESOURCES:
    _FILTERED_RESOURCES = []
    for _R in FOCUS_ENABLED_RESOURCES:
        if _R in _KNOWN_TILT_RESOURCES:
            _FILTERED_RESOURCES.append(_R)
            if _R + '-typecheck' in _KNOWN_TILT_RESOURCES:
                _FILTERED_RESOURCES.append(_R + '-typecheck')
            # Focus expansion normally resolves stack names to concrete
            # resources before this loop, so the stack branch below is not
            # reached for the common `tdk up <stack>` path. Keep a deferred
            # service's separate image prebuild enabled alongside that
            # concrete resource in the expanded focus list.
            if _R + '-image' in _DEFERRED_IMAGE_RESOURCES:
                _FILTERED_RESOURCES.append(_R + '-image')
        elif _R in _STACK_TO_RESOURCE_NAMES:
            for _STACK_RES_NAME in _STACK_TO_RESOURCE_NAMES[_R]:
                _FILTERED_RESOURCES.append(_STACK_RES_NAME)
                _FILTERED_RESOURCES.append(_STACK_RES_NAME + '-run-only')
                _FILTERED_RESOURCES.append(_STACK_RES_NAME + '-config-gen')
                # deferStart backends prebuild their image in a separate
                # local_resource because their dc_resource is not auto-init.
                # Keep that prebuild in focus mode so `tdk up <stack>` still
                # prepares the image before the first request wakes the service.
                # Only when it exists: without a license deferStart is off and
                # no `-image` resource is registered, and Tilt errors on an
                # enabled name it cannot find.
                if _STACK_RES_NAME + '-image' in _DEFERRED_IMAGE_RESOURCES:
                    _FILTERED_RESOURCES.append(_STACK_RES_NAME + '-image')
                if _STACK_RES_NAME + '-typecheck' in _KNOWN_TILT_RESOURCES:
                    _FILTERED_RESOURCES.append(_STACK_RES_NAME + '-typecheck')
        else:
            _MATCHED = [kr for kr in _KNOWN_TILT_RESOURCES if kr != 'service-discovery-daemon' and kr.startswith(_R + '-')]
            _FILTERED_RESOURCES.extend(_MATCHED)
    # NATS is gated by the same 'database-management' should_enable() check as
    # postgres (see infra-loader.star), so it belongs with the infra that is
    # always kept enabled here -- otherwise config.set_enabled_resources()
    # below disables it on every out-of-the-box `tdk up` (pre-alpha always
    # activates this focus-filter branch), and any resource that enables the
    # 'nats' feature never gets a broker to connect to.
    #
    # services/platform/messaging/docker-compose.yml is user-authored (TDK
    # does not generate it) and may declare more than nats/redis -- e.g. a
    # local mail catcher standing in for a managed email provider. Every
    # service it declares is loaded via docker_compose() in infra-loader.star,
    # so it must be enabled here too, or it is silently disabled the same way.
    _ALWAYS_ENABLED_INFRA_RESOURCES = ['init-networks', 'traefik', 'golden-layers-build']
    if should_enable('database-management') or TILT_CONTEXT.get('_shared_platform_postgres_force_started', False):
        _ALWAYS_ENABLED_INFRA_RESOURCES.append('postgres')
    _messaging_compose_path = PROJECT_ROOT + '/services/platform/messaging/docker-compose.yml'
    if str(local("test -f '" + _messaging_compose_path + "' && echo yes || echo no", quiet=True, echo_off=True)).strip() == 'yes':
        # infra-loader.star only creates these Tilt resources when this file
        # exists, so only add them here when they actually exist to add.
        _messaging_compose_doc = read_yaml(_messaging_compose_path, default={})
        for _messaging_svc_name in _messaging_compose_doc.get('services', {}).keys():
            _ALWAYS_ENABLED_INFRA_RESOURCES.append(_messaging_svc_name)
        if 'nats' not in _ALWAYS_ENABLED_INFRA_RESOURCES:
            _ALWAYS_ENABLED_INFRA_RESOURCES.append('nats')
    for _INFRA in _ALWAYS_ENABLED_INFRA_RESOURCES:
        _FILTERED_RESOURCES.append(_INFRA)
    for _KR in _KNOWN_TILT_RESOURCES:
        if _KR.startswith('provision-db-'):
            _FILTERED_RESOURCES.append(_KR)
    _FILTERED_RESOURCES = sorted(set(_FILTERED_RESOURCES))
    if _FILTERED_RESOURCES:
        config.set_enabled_resources(_FILTERED_RESOURCES)
        print("🎯 Focus mode: {} resources".format(len(_FILTERED_RESOURCES)))
    else:
        print("⚠️  No known resources matched focus targets:", ", ".join(FOCUS_ENABLED_RESOURCES))

# =============================================================================
# 👁️ AUTO-DISCOVERY DAEMON
# =============================================================================
if _AUTO_DISCOVER_ENABLED:
    watch_file('snapshots/resource-snapshot.json')
    
    # Get extension install path: vendored copy inside this project
    discovery_path = _local_tdk_path + "/discovery"

    daemon_script = discovery_path + '/resource_snapshot.py'
    daemon_cmd = "cd " + config.main_dir + " && python3 \"" + daemon_script + "\" watch"
    
    local_resource('service-discovery-daemon',
        serve_cmd=daemon_cmd,
        deps=[daemon_script],
        auto_init=True, labels=['discovery'],
        links=[link('file:///snapshots/resource-snapshot.json', 'Resource Snapshot')]
    )
    


print("\n✅ basic-stack Tilt ready!")
