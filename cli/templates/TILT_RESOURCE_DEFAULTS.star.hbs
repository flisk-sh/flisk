def get_resource_port(resource_type, stack_index=0, resource_index=0):
    """
    Calculate service port based on type and indices.

    Args:
    resource_type: "frontend" or "backend"
    stack_index: Index of the stack (for port allocation)
    resource_index: Index of the service within stack

    Returns:
    Port number
    """
    if resource_type == "frontend":
        base = BASE_PORT_FRONTEND
    elif resource_type == "backend":
        base = BASE_PORT_BACKEND
    else:
        fail("Unknown service type: {}".format(resource_type))

    # Allocate ports: base + (stack_index * 100) + resource_index
    return base + (stack_index * 100) + resource_index

