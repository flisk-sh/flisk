{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-core.json",
  "testRunner": "vitest",
  "plugins": ["./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"],
  "vitest": { "configFile": "vitest.stryker.config.ts" },
  "coverageAnalysis": "perTest",
  "inPlace": true,
  "mutate": ["src/generator/template-engine.ts", "src/generator/resource-templates.ts"],
  "reporters": ["json", "clear-text"]
}
