{
  "name": "tdk-cli-internal",
  "private": true,
  "version": "1.3.130",
  "description": "TDK CLI — start services on your machine.",
  "keywords": [
    "tdk",
    "tilt",
    "cli",
    "local-dev",
    "microservices"
  ],
  "homepage": "https://github.com/tdk-landscape/tdk-cli-core#readme",
  "bugs": {
    "url": "https://github.com/tdk-landscape/tdk-cli-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdk-landscape/tdk-cli-core.git",
    "directory": "cli"
  },
  "license": "MIT",
  "author": "TDK Team",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tdk": "bin/tdk.js",
    "tdk-cli": "bin/tdk.js"
  },
  "files": [
    "dist",
    "dist-bundle",
    "bin",
    "templates",
    "README.md",
    "Tiltfile",
    "engine",
    "discovery",
    "specs",
    "ext",
    "!ext/ide-components/code_executor",
    "shared-platform-engineering/docker-templates"
  ],
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "build:watch": "tsc --watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "clean": "rm -rf dist",
    "dev": "bun run build:watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "../scripts/stage-npm-engine.sh && npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "ajv": "^8.17.1",
    "chalk": "^6.0.1",
    "esbuild": "^0.28.2",
    "ink": "^7.1.1",
    "knip": "^6.38.0",
    "react": "^19.3.0",
    "react-devtools-core": "^8.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
