{
  "group": "resource-types",
  "suite": "bring-your-own",
  "description": "A bring-your-own app, job, pair or Python service in each byoVariant on its own check: example (the container alone), flisk (through flisk up and Traefik with Flisk's Postgres), job (a one-shot through flisk up), pair (a dependency and an app through flisk up), python-dry-run (the resource contract and up --dry-run, no Docker) and python-boot (the Python fixture boots and answers its health route), hpc (GPUs, CPU and memory limits and IPC from the container block reach the container and the generated Compose file), infra (the redis, qdrant and rabbitmq presets, reached by a service that depends on them through the settings they provide) and providers (an external provider falls back to a local simulator without its token and switches to remote after the token is added and the service restarts). The matrix runs one leg per variant (#1297).",
  "paths": [
    "docs/byo.md",
    "cli/src/commands/resource.ts",
    "runtime/engine/**",
    "tests/e2e/lib/**",
    "tests/e2e/resource-types/bring-your-own/**",
    ".github/workflows/e2e-resource-types.yml",
    "examples/byo/**",
    "examples/byo/templates.json",
    "scripts/sync-byo-templates.sh",
    "examples/byo-jobs/**",
    "cli/src/commands/up.ts",
    "runtime/engine/schemas/service-schema.json",
    "tests/e2e/fixtures/byo-python-health/**",
    "tests/e2e/fixtures/byo-infra-probe/**",
    "tests/e2e/fixtures/byo-provider-probe/**",
    "cli/src/utils/infra-presets.ts"
  ],
  "cases": [
    "BY1",
    "BY2",
    "BY3",
    "BY4",
    "BY5",
    "BY6",
    "BY7",
    "BY8",
    "BY9"
  ],
  "variants": [
    {
      "id": "example",
      "case": "BY1",
      "args": "echo /health"
    },
    {
      "id": "example-lobster",
      "case": "BY1",
      "args": "lobster /health"

    },
    {
      "id": "example-goose",
      "case": "BY1",
      "args": "goose /health"
    },
    {
      "id": "template-vue",
      "case": "BY1",
      "args": "create-vue /"
    },
    {
      "id": "template-next-app",
      "case": "BY1",
      "args": "create-next-app /"
    },
    {
      "id": "template-adonisjs",
      "case": "BY1",
      "args": "create-adonisjs /"
    },
    {
      "id": "template-analog",
      "case": "BY1",
      "args": "create-analog /"
    },
    {
      "id": "template-bati",
      "case": "BY1",
      "args": "create-bati /"
    },
    {
      "id": "flisk",
      "case": "BY2",
      "args": "full-stack-fastapi-template /api/v1/utils/health-check/"
    },
    {
      "id": "job",
      "case": "BY3",
      "args": "dbmate"
    },
    {
      "id": "pair",
      "case": "BY4",
      "args": "turso 4500 /health turso-app LIBSQL_URL /health"
    },
    {
      "id": "python-dry-run",
      "case": "BY5",
      "args": ""
    },
    {
      "id": "python-boot",
      "case": "BY6",
      "args": ""
    },
    {
      "id": "hpc",
      "case": "BY7",
      "args": ""
    },
    {
      "id": "infra",
      "case": "BY8",
      "args": ""
    },
    {
      "id": "providers",
      "case": "BY9",
      "args": ""
    }
  ],
  "triggers": [
    "pr",
    "nightly",
    "manual"
  ],
  "timeoutMinutes": 30,
  "needsSecrets": []
}
