{
  "group": "resource-types",
  "suite": "backend",
  "description": "A backend resource in each language on a live stack: scaffold with tdk resource --language, tdk up, and a routed health check through Traefik (3.5, #1290). The matrix runs one leg per language.",
  "paths": [
    "cli/src/backend-languages/**",
    "cli/src/backend-frameworks/**",
    "cli/src/commands/resource.ts",
    "engine/**",
    "tests/e2e/lib/**",
    "tests/e2e/resource-types/common.sh",
    "tests/e2e/resource-types/backend/**",
    ".github/workflows/e2e-resource-types.yml"
  ],
  "cases": ["B1", "B2", "B3"],
  "triggers": ["pr", "nightly", "release", "manual"],
  "timeoutMinutes": 25,
  "needsSecrets": []
}
