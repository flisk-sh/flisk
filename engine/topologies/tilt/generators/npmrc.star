# =============================================================================
# 📦 TILT SDK - NPM/BUN CONFIG PROVIDER
# =============================================================================
# Path: .tilt/providers/npmrc.star
# Purpose: Generate .npmrc and bunfig.toml for Verdaccio registry
# =============================================================================
#
# Generates configuration files for:
# - .npmrc / .npmrc.docker.autogenerated - NPM registry configuration
# - bunfig.toml / bunfig.docker.autogenerated.toml - Bun package manager configuration
#
# These files ensure services can install @{npm_scope}/* packages from
# the local Verdaccio registry during development.
# =============================================================================

load("../../../topologies/tilt/common/utils.star", "Utils")

# Output folder constant (consistent with other generators)
OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")

# Load npm scope from project.json (or use project name as default)
# Use TDK_PROJECT_ROOT env var set by Tilt, fallback to current directory
def _load_npm_scope():
    project_root = os.environ.get('TDK_PROJECT_ROOT', '')
    project_json_path = '.tdk/project.json'
    if project_root:
        project_json_path = project_root + '/' + project_json_path
    
    if os.path.exists(project_json_path):
        _project_json = read_json(project_json_path)
        return _project_json.get('project', {}).get('name', 'tdk-project')
    return 'tdk-project'

_NPM_SCOPE = _load_npm_scope()
load("../../../topologies/tilt/manifest/constants.star", "PACKAGE_CONFIG_FILENAMES")

# =============================================================================
# 📝 NPMRC GENERATORS
# =============================================================================

def generate_npmrc(resource_path, registry_url, is_docker, write_fn, verdaccio_enabled=True):
    """
    Generate .npmrc for NPM registry configuration.

    Args:
        resource_path: Path to service directory
        registry_url: Verdaccio registry URL
        is_docker: If True, generates .npmrc.docker.autogenerated, else .npmrc
        write_fn: File writer function
        verdaccio_enabled: If False, scoped packages fall back to public npm (default True)
    """
    target_dir = resource_path + "/" + OUTPUT.AUTOGENERATED_FOLDER
    generated_filename = PACKAGE_CONFIG_FILENAMES['npmrc_docker_autogenerated'] if is_docker else PACKAGE_CONFIG_FILENAMES['npmrc']
    header = Utils.get_template_header("npmrc", target_dir + "/" + generated_filename)

    if verdaccio_enabled:
        # Verdaccio's default policy permits anonymous reads and requires
        # authentication only for publishing. Keep user credentials in the
        # user's npm config; generated project files must not contain defaults.
        content = """{header}
registry=https://registry.npmjs.org/
@{npm_scope}:registry={registry_url}/
@tdk-landscape:registry={registry_url}/
@identity:registry={registry_url}/""".format(header=header, registry_url=registry_url, npm_scope=_NPM_SCOPE)
    else:
        # Verdaccio not enabled (no license key) — all scopes use public npm
        content = """{header}
registry=https://registry.npmjs.org/
@{npm_scope}:registry=https://registry.npmjs.org/
@tdk-landscape:registry=https://registry.npmjs.org/
@identity:registry=https://registry.npmjs.org/""".format(header=header, npm_scope=_NPM_SCOPE)
    
    filename = generated_filename
    write_fn(target_dir + '/' + filename, content)


# =============================================================================
# 📝 BUNFIG GENERATORS
# =============================================================================

def generate_bunfig(resource_path, registry_url, is_docker, write_fn, verdaccio_enabled=True):
    """
    Generate bunfig.toml for Bun package manager configuration.

    Args:
        resource_path: Path to service directory
        registry_url: Verdaccio registry URL
        is_docker: If True, generates bunfig.docker.autogenerated.toml, else bunfig.toml
        write_fn: File writer function
        verdaccio_enabled: If False, scoped packages fall back to public npm (default True)
    """
    target_dir = resource_path + "/" + OUTPUT.AUTOGENERATED_FOLDER
    generated_filename = PACKAGE_CONFIG_FILENAMES['bunfig_docker_autogenerated'] if is_docker else PACKAGE_CONFIG_FILENAMES['bunfig']
    header = Utils.get_template_header("bunfig", target_dir + "/" + generated_filename)

    if verdaccio_enabled:
        content = """{header}
[install]
linker = "isolated"
linkWorkspacePackages = true
registry = "https://registry.npmjs.org"

[install.scopes]
"@{npm_scope}" = {{ url = "{registry_url}/" }}
"@tdk-landscape" = {{ url = "{registry_url}/" }}
"@identity" = {{ url = "{registry_url}/" }}

""".format(header=header, registry_url=registry_url, npm_scope=_NPM_SCOPE)
    else:
        # Verdaccio not enabled (no license key) — all scopes use public npm
        content = """{header}
[install]
linker = "isolated"
linkWorkspacePackages = true
registry = "https://registry.npmjs.org"

""".format(header=header)

    filename = generated_filename
    write_fn(target_dir + '/' + filename, content)


# =============================================================================
# 🎯 PUBLIC API - Struct-based Exports
# =============================================================================

PackageConfig = struct(
    npmrc = generate_npmrc,
    bunfig = generate_bunfig,
)
