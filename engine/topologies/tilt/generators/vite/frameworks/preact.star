# Preact-specific Vite templates for frontend resources.

PREACT_VITE_FRONTEND = """{header}
import {{ resolve }} from 'node:path';
import preact from '@preact/preset-vite';
import {{ defineConfig }} from 'vite';

export default defineConfig({{
  base: '{base_path}',
  build: {{
    cssCodeSplit: false,
    minify: false,
    modulePreload: false,
    rollupOptions: {{
      output: {{
        entryFileNames: '[name].js',
        format: 'esm',
      }},
    }},
    target: 'esnext',
  }},
  define: {{
    global: 'globalThis',
  }},
  optimizeDeps: {{
    include: [{optimize_deps_include}],
  }},
  plugins: [preact()],
  preview: {{
    host: '0.0.0.0',
    port: {port},
  }},
  resolve: {{
    alias: {{
      '@/autogenerated': resolve(__dirname),
      '@': resolve(__dirname, '../src'),
      'set-cookie-parser': resolve(__dirname, '../src/utils/empty-module.js'),
{internal_aliases}
    }},
  }},
  server: {{
    host: '0.0.0.0',
    port: {port},
    hmr: {{
      port: {hmr_port},
    }},
{proxy_config}
  }},
}});
"""

PREACT_VITE_FRONTEND_BUILD = """{header}
import {{ resolve }} from 'node:path';
import preact from '@preact/preset-vite';
import {{ defineConfig }} from 'vite';

export default defineConfig({{
  mode: 'production',
  base: '{base_path}',
  build: {{
    cssCodeSplit: false,
    minify: true,
    modulePreload: false,
    rollupOptions: {{
      output: {{
        entryFileNames: '[name].js',
        format: 'esm',
        manualChunks: undefined,
      }},
    }},
    target: 'esnext',
  }},
  define: {{
    global: 'globalThis',
    __DEV__: 'false',
    'process.env.NODE_ENV': '"production"',
  }},
  optimizeDeps: {{
    include: [{optimize_deps_include}],
  }},
  plugins: [preact()],
  resolve: {{
    alias: {{
      '@/autogenerated': resolve(__dirname),
      '@': resolve(__dirname, '../src'),
      'set-cookie-parser': resolve(__dirname, '../src/utils/empty-module.js'),
    }},
    conditions: ['browser', 'import', 'module', 'es2020', 'default'],
    mainFields: ['browser', 'module', 'jsnext:main', 'jsnext', 'main'],
  }},
}});
"""
