# === INLINED CONSTANTS for pure extension loading ===
OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")
# === END INLINED CONSTANTS ===


load("../../../../topologies/tilt/common/utils.star", "Utils")
load("../../../../topologies/tilt/manifest/constants.star", "GENERATED_CONFIG_FILENAMES")


# =============================================================================
# Prisma Config Generator
# =============================================================================

def generate_prisma_config(resource_path, resource_name, db_name, write_fn):
    """
    Generate prisma.config.autogenerated.ts for Prisma v7 CLI configuration.

    Args:
        resource_path: Path to the resource directory
        resource_name: Name of the resource
        db_name: Name of the database
        write_fn: Write function for file output

    Returns:
        str: Generated Prisma config content
    """
    resource_display_name = resource_name

    header = Utils.get_template_header(
        GENERATED_CONFIG_FILENAMES['prisma'],
        'TypeScript.prisma()',
        resource_display_name,
        'Prisma Configuration'
    )
    content = """/**
 * AUTOGENERATED Prisma CLI Configuration - %s Service
 *
 * This config is used by Prisma CLI commands (generate, migrate, db push).
 */
export default {
  schema: 'prisma/schema.prisma',
  datasource: {
    url: process.env.DATABASE_URL,
  },
};
""" % (resource_name)
    
    if write_fn:
        write_fn(resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/' + GENERATED_CONFIG_FILENAMES['prisma'], content)
