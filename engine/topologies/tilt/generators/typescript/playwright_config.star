load('../../../../topologies/tilt/common/utils.star', 'Utils')
load('../../../../topologies/tilt/manifest/constants.star', 'GENERATED_CONFIG_FILENAMES')

OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")

_STUB_NOTICE = """// Playwright e2e config generation is a paid Flisk feature.
// Run `flisk upgrade` to enable generated Playwright configs for this service.
"""


def generate_playwright_config(resource_path, resource_type='backend', write_fn=None):
    """
    Free-tier stub - see module header. Signature matches the licensed
    implementation so callers never need to know which one is active.
    """
    resource_name = resource_path.split('/')[-1]
    header = Utils.get_template_header(
        GENERATED_CONFIG_FILENAMES['playwright'],
        'TypeScript.generate_playwright_config() [unlicensed stub]',
        resource_name,
        resource_type.upper()
    )
    content = header + _STUB_NOTICE

    if write_fn:
        write_fn(resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/' + GENERATED_CONFIG_FILENAMES['playwright'], content)

    return content
