# === INLINED CONSTANTS for pure extension loading ===
OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")
# === END INLINED CONSTANTS ===


BUN_BASE = "oven/bun:1.3.11-alpine"
ALPINE_BASE = "alpine:3.22"


load('../../../tilt/common/utils.star', 'Utils')
load('../../../tilt/manifest/constants.star', 'GENERATED_CONFIG_FILENAMES')

# Load layer generators from dedicated modules
load('../layers/l1_base_layers.star', 'L1_generate_os_base', 'L1_generate_runtime_env')
load('../layers/l2_dependency_layers.star', 'L2_generate_dependency_manifest')
load('../layers/l3_builder_layers.star', 
    'L3_generate_backend_compiler', 
    'L3_generate_frontend_builder',
    'L3_generate_production_purger'
)
load('../layers/prisma/prisma_build.star', 'L3_generate_migration_engine')
load('../layers/prisma/prisma_runtime.star', 'L4_generate_migrator_runtime')
load('../layers/l4_runtime_layers.star',
    'L4_generate_backend_runtime',
    'L4_generate_frontend_runtime',
)

def L4_generate_orchestrator(res_path, res_type = 'backend', resource_name = 'service', use_nginx = False, port = 3000, target_path = '/app/dist', build_cmd = 'bun run build', cmd = 'bun run start', use_infisical = False, use_shared_libs = True, use_prisma = True, use_golden = True, manifest = None):
    parts = []
    migrator_name_match = (
        resource_name == 'migrator'
        or resource_name.endswith('-migrator')
        or resource_name.endswith('-db-migrator')
    )
    prisma_config_exists = use_prisma and read_file(res_path + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/' + GENERATED_CONFIG_FILENAMES['prisma'], default='') != ''
    parts.append(L1_generate_os_base(use_golden=use_golden))
    parts.append(L1_generate_runtime_env(None))
    parts.append(L2_generate_dependency_manifest(res_path, use_golden=use_golden))

    if res_type == 'migrator' or (res_type == 'backend' and migrator_name_match):
        # For migrators, skip backend_compiler and production_purger.
        # Keep migration_engine only.
        parts.append(L3_generate_migration_engine(res_path, use_golden=use_golden))
    elif res_type == 'frontend':
        parts.append(L3_generate_frontend_builder(res_path, build_cmd, use_infisical, use_shared_libs, use_golden=use_golden))
    else:
        parts.append(L3_generate_backend_compiler(res_path, build_cmd, use_prisma, use_shared_libs, use_infisical, use_golden=use_golden, has_prisma_config=prisma_config_exists))
        # Backend runtime needs production-purged deps. Prisma migration stage
        # is only required when Prisma is enabled for this resource.
        if use_prisma:
            parts.append(L3_generate_migration_engine(res_path, use_golden=use_golden))
        parts.append(L3_generate_production_purger(res_path))

    if res_type == 'frontend':
        parts.append(L4_generate_frontend_runtime(res_path, target_path, use_nginx, use_golden=use_golden, port=port))
    elif res_type == 'migrator' or (res_type == 'backend' and migrator_name_match):
        parts.append(L4_generate_migrator_runtime(res_path, resource_name, use_golden=use_golden))
    else:
        parts.append(
            L4_generate_backend_runtime(
                res_path,
                port,
                cmd,
                use_infisical,
                resource_name,
                use_golden=use_golden,
                use_prisma=use_prisma,
                has_prisma_config=prisma_config_exists,
                manifest=manifest,
            ),
        )
    dockerfile = "\n\n".join(parts)
    footer = Utils.get_template_header("dockerfile", "golden_docker_generator_v2.L4_generate_orchestrator", resource_name, "Use docker_build(dockerfile_contents=...) in Tiltfile")
    # Heredocs (RUN cat > ... << 'EOF') need the BuildKit frontend; without this line an older builder
    # reads the heredoc body as instructions ("unknown instruction: export").
    return "# syntax=docker/dockerfile:1\n" + dockerfile + "\n\n" + footer
