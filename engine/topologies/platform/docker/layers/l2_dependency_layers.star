# === INLINED CONSTANTS for pure extension loading ===
RUNTIME = "bun"
# === END INLINED CONSTANTS ===


"""
L2 Dependency Layers - Package Manifest and Dependency Resolution

Handles the dependency layers for efficient Docker caching:
- l2_dependency_manifest: Copy and install package manifests
- l2_dependency_resolver: Cache resolved dependencies
"""

load('./l1_base_layers.star', 'BUN_BASE')
load('../../../../../discovery/config.star', 'GLOBAL_CONFIG')
load('../../../tilt/common/utils_debug.star', 'DEBUG_MODE')
load('../../../tilt/manifest/constants.star', 'AUTOGENERATED_CONFIG_PATHS', 'GENERATED_CONFIG_FILENAMES')


# Load project name for dynamic golden image naming
# Use TDK_PROJECT_ROOT env var set by Tilt, fallback to current directory
def _load_golden_prefix():
    project_root = os.environ.get('TDK_PROJECT_ROOT', '')
    project_json_path = '.tdk/project.json'
    if project_root:
        project_json_path = project_root + '/' + project_json_path
    
    if os.path.exists(project_json_path):
        _project_json = read_json(project_json_path)
        return _project_json.get('project', {}).get('name', 'tdk-project')
    return 'tdk-project'

_GOLDEN_PREFIX = _load_golden_prefix()

GOLDEN_L2_IMAGE = GLOBAL_CONFIG['docker'].get('golden_l2_image', _GOLDEN_PREFIX + '-l2:latest')


def normalize_res_path(res_path):
    """Normalize resource path for Docker COPY commands.
    
    Docker COPY requires paths relative to the build context (project root).
    Absolute filesystem paths must become project-relative (including ../sibling).
    Never strip only the leading '/' — that turns
    `/private/var/.../platform/verdaccio` into a fake in-repo path.
    
    Args:
        res_path: Resource path (may be absolute or relative)
    
    Returns:
        Normalized relative path for Docker COPY
    """
    if not res_path:
        return res_path
    if not res_path.startswith('/'):
        return res_path
    project_root = os.environ.get('TDK_PROJECT_ROOT', '.')
    cmd = (
        "python3 -c \"import os; print(os.path.relpath(os.path.realpath('''" +
        res_path +
        "'''), os.path.realpath('''" +
        project_root +
        "''')))\""
    )
    relative = str(local(cmd, quiet=True, echo_off=True)).strip()
    if relative:
        return relative
    root_prefix = project_root.rstrip('/') + '/'
    if res_path.startswith(root_prefix):
        return res_path[len(root_prefix):]
    return res_path[1:]


def L2_generate_dependency_manifest(res_path, manager = RUNTIME, use_golden = True):
    """
    Generate the dependency manifest layer that copies package files.
    This layer is cached independently for faster builds.
    
    Args:
        res_path: Resource path (service directory)
        manager: Package manager to use (default: RUNTIME from master config)
        use_golden: Whether to use golden L2 image (default: True)
    
    Returns:
        Dockerfile content string for the l2_deps_manifest stage
    """
    # Normalize res_path for Docker COPY (must be relative to build context)
    res_path_rel = normalize_res_path(res_path)

    # Prefer golden L2 image when enabled and defined; fall back to plain Bun image.
    base_image = GOLDEN_L2_IMAGE if (use_golden and GOLDEN_L2_IMAGE) else BUN_BASE
    use_golden_for_manifest = base_image == GOLDEN_L2_IMAGE
    debug_tools_install = "" if use_golden_for_manifest else "# Install debugging tools for troubleshooting\nRUN echo '🔧 Installing debug tools...' && apk add --no-cache curl netcat-openbsd jq bind-tools vim && echo '✅ Debug tools installed'\n"

    diagnostics_block = """
# Comprehensive pre-flight diagnostics (debug mode)
RUN echo '🔍 DEPENDENCY INSTALLATION DIAGNOSTICS (debug)' && \\
    echo "Bun version: $(bun --version)" && \\
    echo "Lock files:" && ls -lh bun.lock* 2>/dev/null && \\
    echo "Cache dir:" && ls -lh /cache/bun 2>/dev/null || true
"""
    if not DEBUG_MODE:
        diagnostics_block = "# Diagnostics suppressed (set TILT_DEBUG=true for verbose output)\n"

    install_deps_verbose = "INSTALL_DEPS_VERBOSE=1 " if DEBUG_MODE else ""

    return (
        "# ---- L2: dependency_manifest ----\n"
        + "FROM " + base_image + " AS l2_deps_manifest\n"
        + "WORKDIR /app\n"
        + "\n"
        + "# Cache-busting mechanism - change this value to force dependency reinstall\n"
        + "ARG CACHE_BUSTER=2026-06-25-v1\n"
        + "RUN echo \"Cache buster: ${CACHE_BUSTER}\"\n"
        + "\n"
        + debug_tools_install
        + "\n"
        + "# Copy workspace root for monorepo resolution\n"
        + "COPY package.json ./package.json\n"
        + "COPY " + res_path_rel + "/" + AUTOGENERATED_CONFIG_PATHS['npmrc_docker'] + " /app/.npmrc\n"
        + "COPY " + res_path_rel + "/" + AUTOGENERATED_CONFIG_PATHS['bunfig_docker'] + " /app/.bunfig.toml\n"
        + "\n"
        + "# Copy service manifest files for deterministic dependency layer\n"
        + "WORKDIR /app/" + res_path + "\n"
        + "COPY " + res_path_rel + "/package.json ./package.json\n"
        + "COPY " + res_path_rel + "/" + AUTOGENERATED_CONFIG_PATHS['npmrc_docker'] + " .npmrc\n"
        + "COPY " + res_path_rel + "/" + AUTOGENERATED_CONFIG_PATHS['bunfig_docker'] + " .bunfig.toml\n"
        + "\n"
        + diagnostics_block
        + "# Install dependencies (quiet by default; set TILT_DEBUG=true for verbose diagnostics)\n"
        + "COPY shared-platform-engineering/docker-templates/install-deps.sh /usr/local/bin/install-deps.sh\n"
        # NOTE: sharing=shared allows parallel builds (20+ services) without lock contention.
        # Bun's cache uses content-addressable storage with atomic writes, so concurrent access is safe.
        + "RUN --mount=type=cache,target=/cache/bun,sharing=shared chmod +x /usr/local/bin/install-deps.sh && start_ts=$(date +%s) && "
        + install_deps_verbose
        + "/usr/local/bin/install-deps.sh && end_ts=$(date +%s) && echo \"install-deps duration: $((end_ts-start_ts))s\"\n"
        # Guarantee /app/node_modules/.bun exists so L3's COPY --link never
        # fails with "not found". Bun's isolated linker only creates this dir
        # when hoisted packages are present; without TDK_LICENSE_KEY the public-
        # npm install may skip it entirely.
        + "RUN mkdir -p /app/node_modules/.bun\n"
    )

DEBUG = {}

GLOBAL_CONFIG = {}
