{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flisk.sh/project-schema.json",
  "title": "Flisk Project Configuration",
  "description": "Editor assistance for .flisk/project.json. The Flisk CLI remains the runtime source of truth.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "project",
    "phases",
    "optional_infra",
    "discovery"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "minFliskVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Oldest flisk CLI this project works with, as MAJOR.MINOR.PATCH. flisk doctor fails on an older CLI."
    },
    "minTdkVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Deprecated alias for minFliskVersion. Use minFliskVersion instead."
    },
    "pinnedFliskVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Exact flisk CLI version this project requires, as MAJOR.MINOR.PATCH."
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pre_alpha",
        "alpha",
        "beta",
        "out_of_scope"
      ],
      "properties": {
        "pre_alpha": {
          "$ref": "#/definitions/phase"
        },
        "alpha": {
          "$ref": "#/definitions/phase"
        },
        "beta": {
          "$ref": "#/definitions/phase"
        },
        "out_of_scope": {
          "$ref": "#/definitions/phase"
        }
      }
    },
    "stacks": {
      "type": "object",
      "additionalProperties": true
    },
    "always_enabled_infra": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedHosts": {
      "type": "array",
      "description": "Hosts outside the local stack that env values may point at on purpose (a payment sandbox, a model API). flisk doctor does not report them. \"*.example.com\" matches every subdomain.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "properties": {
        "gateway": {
          "type": "boolean",
          "description": "Whether to provision the Traefik reverse proxy and gateway routing."
        },
        "database": {
          "type": "boolean",
          "description": "Whether to provision the bundled shared PostgreSQL (database-management). A service that declares dependsOn postgres still gets it."
        }
      }
    },
    "optional_infra": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "monitoring",
        "elk",
        "debezium",
        "golden_image",
        "verdaccio"
      ],
      "properties": {
        "monitoring": {
          "type": "boolean"
        },
        "elk": {
          "type": "boolean"
        },
        "debezium": {
          "type": "boolean"
        },
        "golden_image": {
          "type": "boolean"
        },
        "verdaccio": {
          "type": "boolean"
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "definitions": {
    "phase": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "description",
        "enabledStacks"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enabledStacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
