# Dockerfiles for backends whose `language` is not the Bun default.
#
# Bun backends use the golden-image generator. Python backends are a small
# standalone image: language-specific base image and reload command, while the build
# context (project root), `production` target, health check, and PORT contract stay the
# same as every other backend.

load("../layers/bun_helpers.star", "bun_dev_script", "bun_dev_script_watches")

BASE_PORT_BACKEND = 4000

# App types whose Bun image can run the `dev` script under a watcher (service.json `dev.liveReload` applies to these).
BUN_LIVE_RELOAD_APP_TYPES = ["backend", "worker", "agent", "mcp"]

# Languages whose runtime files are owned by the provider (no Vite/tsconfig/Bun config).
PROVIDER_OWNED_LANGUAGES = ["python", "go", "rust", "node"]

# Files a provider-owned language must scaffold; checked before generating anything.
LANGUAGE_REQUIRED_FILES = {
    "python": ["pyproject.toml", "src/main.py"],
    "go": ["go.mod", "main.go"],
    "rust": ["Cargo.toml", "src/main.rs"],
    "node": ["package.json", "src/index.js"],
}

_CURL = """RUN apt-get update && apt-get install -y --no-install-recommends curl \\
  && rm -rf /var/lib/apt/lists/*
"""

_HEALTHCHECK = """HEALTHCHECK --interval=10s --timeout=5s --retries=3 \\
  CMD curl -f http://localhost:${{PORT:-{port}}}/health || exit 1
"""

_PYTHON = """# Generated by Flisk for a Python backend. Do not edit; change service.json instead.
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS base

WORKDIR /app/{res_path}

{curl}
COPY {res_path}/pyproject.toml ./
# Wheel then install the wheel only. Scorecard treats a pip install of a
# .whl as hash-pinned; `pip install .` is not.
RUN python -m pip wheel --no-cache-dir --wheel-dir /tmp/wheels .
RUN pip install --no-cache-dir /tmp/wheels/*.whl

COPY {res_path}/src ./src

FROM base AS test
RUN python -m pip wheel --no-cache-dir --wheel-dir /tmp/wheels-dev ".[dev]"
RUN pip install --no-cache-dir /tmp/wheels-dev/*.whl
COPY {res_path}/tests ./tests
RUN pytest

FROM base AS production

{healthcheck}
EXPOSE {port}

CMD ["sh", "-c", "uvicorn main:app --app-dir src --host 0.0.0.0 --port ${{PORT:-{port}}} --reload --reload-dir src"]
"""

_GO = """# Generated by Flisk for a Go backend. Do not edit; change service.json instead.
FROM golang:1.27-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS build
# The official image pins GOTOOLCHAIN=local, so a go.mod that needs a newer Go (Gin 1.12 needs 1.25) stops with "requires go >= 1.25".
# `auto` lets Go fetch the toolchain go.mod asks for; a go.mod at or below the image's Go downloads nothing.
ENV GOTOOLCHAIN=auto

WORKDIR /app/{res_path}

COPY {res_path}/go.* ./
RUN go mod download

COPY {res_path}/ ./
RUN CGO_ENABLED=0 go build -o /out/app .

FROM build AS test
RUN go test ./...
{go_development}
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS production

{curl}
COPY --from=build /out/app /usr/local/bin/app

{healthcheck}
EXPOSE {port}

CMD ["app"]
"""

_RUST = """# Generated by Flisk for a Rust backend. Do not edit; change service.json instead.
# BuildKit cache mounts keep the registry and the target directory between builds, so a rebuild after a
# source change recompiles only the crate itself, not every dependency.
FROM rust:1-slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37 AS build

WORKDIR /app/{res_path}

COPY {res_path}/ ./
RUN --mount=type=cache,target=/usr/local/cargo/registry \\
    --mount=type=cache,target=/app/{res_path}/target \\
    cargo build --release && mkdir -p /out && cp target/release/app /out/app

FROM build AS test
RUN --mount=type=cache,target=/usr/local/cargo/registry \\
    --mount=type=cache,target=/app/{res_path}/target \\
    cargo test

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS production

{curl}
COPY --from=build /out/app /usr/local/bin/app

{healthcheck}
EXPOSE {port}

CMD ["app"]
"""

_NODE = """# Generated by Flisk for a Node.js backend. Do not edit; change service.json instead.
FROM node:22-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS base

WORKDIR /app/{res_path}

{curl}
COPY {res_path}/package*.json ./
RUN npm ci --omit=dev

COPY {res_path}/src ./src

FROM base AS test
RUN npm ci
COPY {res_path}/tests ./tests
RUN npm test

FROM base AS production

{healthcheck}
EXPOSE {port}

CMD ["node", "src/index.js"]
"""


# The watcher the Go development target runs. It compiles a change into a staging binary while the running app keeps serving, and stops
# and swaps the app only when that build succeeds. Air was tried first and stops the app as soon as it sees a change (engine.go `start`
# calls stopBin before buildRun), so the service stayed down for the whole compile; a Traefik health check landing in that gap kept the
# route at 503 for up to 10s. A compile error is printed to the log and the last good build keeps serving.
# `-s -w` drops debug info, which shortens the link step; delve cannot attach to a binary built this way.
# `\\n` in find's -printf format is written with a doubled backslash so the shell receives a backslash and an n.
#
# Test-on-save (#684): when the image sets FLISK_GO_TEST_ON_SAVE, the same loop also runs `go test` in the background after each
# restart, so a slow suite never delays the reload. The scope is "changed" (only the packages owning the changed files) or a fixed
# `go test` pattern such as ./.... go.mod/go.sum changes arrive as an image rebuild, so the first pass after a container start always
# covers every package. A newer save replaces a running test pass; tests are never queued.
_GO_DEV_WATCH = """#!/bin/sh
app=/tmp/app
next=/tmp/app.next
pid=

# Test-on-save state; every helper below stays inert until the image sets FLISK_GO_TEST_ON_SAVE.
test_on_save=${FLISK_GO_TEST_ON_SAVE:-}
test_pid=
test_snap=/tmp/flisk-go-test.snap
test_new=/tmp/flisk-go-test.snap.new
test_paths=/tmp/flisk-go-test.paths
test_pkgs=/tmp/flisk-go-test.pkgs

# Path, mtime and size of every file a Go build can read. Dot-directories (.git, .autogenerated), tmp/, tests and docs are ignored.
signature() {
  find . -type f -not -path '*/.*' -not -path './tmp/*' -not -name '*_test.go' -not -name '*.md' -printf '%p %T@ %s\\n' | sort | cksum
}

# The same tree plus *_test.go files: everything a `go test` run can observe, so a test-only save is still seen.
test_signature() {
  find . -type f -not -path '*/.*' -not -path './tmp/*' -not -name '*.md' -printf '%p %T@ %s\\n' | sort | cksum
}

# Size, mtime and path of every test-visible file; a changed line is an added, edited or deleted file.
test_snapshot() {
  find . -type f -not -path '*/.*' -not -path './tmp/*' -not -name '*.md' -printf '%s %T@ %p\\n' | sort
}

# Replaces the stored snapshot with the current one and writes the paths that changed since it to $test_paths.
test_changed_paths() {
  test_snapshot > "$test_new"
  { comm -13 "$test_snap" "$test_new"; comm -23 "$test_snap" "$test_new"; } | cut -d' ' -f3- | sort -u > "$test_paths"
  mv "$test_new" "$test_snap"
}

# Directories that hold at least one non-test Go file, one per line.
go_package_dirs() {
  find . -type f -name '*.go' -not -name '*_test.go' -not -path '*/.*' -not -path './tmp/*' -printf '%p\\n' | sed 's|/[^/]*$||' | sort -u
}

# Prints the `go test` arguments for the changed paths in $1: ./... when go.mod or go.sum changed (a dependency
# change can affect any package), else the nearest folder holding Go files for each path, so an embedded asset
# tests the package that embeds it. Prints nothing when no package owns the change.
test_args() {
  all=
  while IFS= read -r path; do
    case "$path" in
      */go.mod|*/go.sum) all=1; break ;;
    esac
  done < "$1"
  if [ -n "$all" ]; then
    printf '%s\\n' "./..."
    return
  fi
  dirs=$(go_package_dirs)
  pkgs=
  while IFS= read -r path; do
    dir=${path%/*}
    prev=
    while [ "$dir" != "$prev" ]; do
      prev=$dir
      if printf '%s\\n' "$dirs" | grep -qxF -- "$dir"; then
        pkgs="$pkgs$dir
"
        break
      fi
      dir=${dir%/*}
    done
  done < "$1"
  printf '%s' "$pkgs" | sort -u
}

# Stops the running test pass, if any: the newest save wins and tests are never queued. Never fails: the pid may
# already be gone or reaped by the time a newer save arrives.
stop_tests() {
  if [ -n "$test_pid" ]; then
    kill -TERM -- "-$test_pid" 2>/dev/null || kill "$test_pid" 2>/dev/null || true
    wait "$test_pid" 2>/dev/null || true
    test_pid=
  fi
}

# Runs `go test` in the background: "changed" resolves the packages owning the paths in $test_paths, anything
# else is passed to `go test` as a package pattern (for example ./...). Output lands in the container log.
run_tests() {
  stop_tests
  if [ "$1" = "changed" ]; then
    test_args "$test_paths" > "$test_pkgs"
    if [ ! -s "$test_pkgs" ]; then
      echo "[flisk] go test: the change belongs to no Go package; skipping"
      return
    fi
  else
    printf '%s\\n' "$1" > "$test_pkgs"
  fi
  echo "[flisk] running go test on: $(paste -sd' ' "$test_pkgs")"
  setsid sh -c 'xargs go test < "$1"; rc=$?; echo "[flisk] go test exited with status $rc"; exit $rc' sh "$test_pkgs" &
  test_pid=$!
}

# The app runs in its own session so a signal reaches everything it forked and no child keeps the listen socket.
start_app() {
  setsid "$app" &
  pid=$!
}

# Succeeds only when the app is really gone; a swap on top of a live process would fail (ETXTBSY) or hit address-in-use.
stop_app() {
  [ -n "$pid" ] || return 0
  kill -TERM -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null
  waited=0
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 50 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done
  kill -KILL -- "-$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null
  wait "$pid" 2>/dev/null
  if kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  pid=
}

trap 'stop_app; exit 0' TERM INT

last=$(signature)
last_test=
if [ -n "$test_on_save" ]; then
  test_snapshot > "$test_snap"
  last_test=$(cksum < "$test_snap")
fi
echo "[flisk] watching for Go changes; the running app keeps serving while a rebuild compiles"
start_app
if [ -n "$test_on_save" ]; then
  # A fresh container usually follows an image rebuild (go.mod, go.sum or the Dockerfile changed), so the first
  # pass covers every package; saves after that test only the packages that changed.
  if [ "$test_on_save" = "changed" ]; then
    run_tests "./..."
  else
    run_tests "$test_on_save"
  fi
fi

while true; do
  sleep 0.2 &
  wait $!
  if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
    wait "$pid"
    echo "[flisk] the app exited with status $?; waiting for a change to rebuild"
    pid=
  fi
  now=$(signature)
  test_changed=
  if [ -n "$test_on_save" ]; then
    now_test=$(test_signature)
    if [ "$now_test" != "$last_test" ]; then
      test_changed=1
      last_test=$now_test
      test_changed_paths
    fi
  fi
  if [ "$now" = "$last" ] && [ -z "$test_changed" ]; then
    continue
  fi
  if [ "$now" != "$last" ]; then
    last=$now
    echo "[flisk] change detected, rebuilding..."
    if go build -ldflags='-s -w' -o "$next" . ; then
      if stop_app && mv "$next" "$app"; then
        start_app
        echo "[flisk] rebuilt and restarted"
        [ -n "$test_on_save" ] && run_tests "$test_on_save"
      else
        echo "[flisk] could not stop the running app or install the new build; save again to retry"
        last=
      fi
    else
      echo "[flisk] build failed; the last good build keeps running. Fix the error and save again."
    fi
  elif [ -n "$test_on_save" ]; then
    # Only test files changed: no rebuild, but the packages owning them still get a test pass.
    run_tests "$test_on_save"
  fi
done
"""

# Opt-in Go development target (`dev.liveReload`): the toolchain image plus the watcher above, which rebuilds and restarts the app when a
# source file changes. Dependencies are downloaded in their own layer and the module download is its own image layer, so an ordinary
# source edit recompiles incrementally. `go.mod`, `go.sum` and the Dockerfile still rebuild the image. The heredoc needs BuildKit's
# Dockerfile frontend 1.4 (Docker Engine 23+).
_GO_DEVELOPMENT = """
FROM golang:1.27-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS development
ENV GOTOOLCHAIN=auto
WORKDIR /app/{res_path}
COPY {res_path}/go.* ./
# A plain RUN (not a cache mount) keeps the modules in a layer keyed on go.mod and go.sum, so the priming build below reuses them.
RUN go mod download
COPY {res_path}/ ./
ENV GOFLAGS=-buildvcs=false CGO_ENABLED=0
{test_on_save_env}# Prime the build cache inside the image (a cache mount would not be kept), so the first edit recompiles only what changed.
# Same flags as the watcher's builds (and CGO off like the production stage), so the primed binary and cache match every later one.
RUN go build -ldflags='-s -w' -o /tmp/app .
COPY --chmod=755 <<'FLISK_GO_DEV_WATCH' /usr/local/bin/flisk-go-watch
{watch_script}
FLISK_GO_DEV_WATCH
EXPOSE {port}
CMD ["flisk-go-watch"]
"""

def generate_language_dockerfile(res_path, language, port = BASE_PORT_BACKEND, dev = False, test_on_save = ""):
    """Dockerfile text for a provider-owned backend language, or fail for an unknown one.

    `test_on_save` is the resolved `go test` scope for the Go development target ("changed" for the
    packages owning the changed files, or a fixed pattern such as ./...); empty leaves the watcher inert.
    """
    template = {"python": _PYTHON, "go": _GO, "rust": _RUST, "node": _NODE}.get(language)
    if template == None:
        fail("No Dockerfile generator for backend language '{}'".format(language))
    go_development = ""
    if dev and language == "go":
        go_development = _GO_DEVELOPMENT.format(
            res_path = res_path,
            port = port,
            watch_script = _GO_DEV_WATCH.rstrip("\n"),
            test_on_save_env = "ENV FLISK_GO_TEST_ON_SAVE={}\n".format(test_on_save) if test_on_save else "",
        )
    return template.format(
        res_path = res_path,
        port = port,
        go_development = go_development,
        curl = _CURL,
        healthcheck = _HEALTHCHECK.format(port = port),
    )


def is_next_frontend(manifest):
    """True for a frontend whose `framework` is `next`: it runs on Node, not as a Vite build behind nginx."""
    return bool(manifest) and manifest.get("appType") == "frontend" and manifest.get("framework") == "next"


def is_provider_owned_language(manifest):
    """True when the manifest selects a provider-owned language (a missing language means Bun)."""
    if not manifest:
        return False
    return manifest.get("appType", "backend") == "backend" and manifest.get("language", "bun") in PROVIDER_OWNED_LANGUAGES


def go_live_reload_enabled(manifest):
    """True for a Go service that opted in with `dev.liveReload: true` (see _GO_DEVELOPMENT); anything else stays off."""
    if not manifest or manifest.get("language", "bun") != "go":
        return False
    dev = manifest.get("dev")
    if type(dev) != "dict":
        return False
    return dev.get("liveReload") == True

def go_test_on_save_enabled(manifest):
    """True for a Go service that opted in with `dev.testOnSave` (boolean or dict with enabled: True); anything else stays off."""
    if not manifest or manifest.get("language", "bun") != "go":
        return False
    dev = manifest.get("dev")
    if type(dev) != "dict":
        return False
    test_on_save = dev.get("testOnSave")
    if test_on_save == True:
        return True
    if type(test_on_save) == "dict":
        return test_on_save.get("enabled", True) == True
    return False

def go_test_on_save_scope(manifest):
    """The `go test` scope for a Go service's `dev.testOnSave`: "changed" for the packages owning the changed
    files by default, the configured `packages` pattern (for example ./...) when set, or "" when off."""
    if not go_test_on_save_enabled(manifest):
        return ""
    dev = manifest.get("dev")
    test_on_save = dev.get("testOnSave")
    if type(test_on_save) == "dict":
        packages = test_on_save.get("packages")
        if packages and type(packages) == "string" and packages.strip():
            return packages.strip()
    return "changed"

def bun_live_reload_enabled(manifest, res_path):
    """True for a Bun service that reloads on a synced edit (#3395): its package.json `dev` script runs under `bun --watch`/`--hot` and `dev.liveReload` is not `false`.

    Only the Dockerfile Flisk generates has a `development` stage that runs that script; see L4_generate_backend_runtime.
    """
    if not manifest or manifest.get("language", "bun") != "bun":
        return False
    if manifest.get("appType", "backend") not in BUN_LIVE_RELOAD_APP_TYPES:
        return False
    dev = manifest.get("dev")
    if type(dev) == "dict" and dev.get("liveReload") == False:
        return False
    return bun_dev_script_watches(bun_dev_script(res_path))

def python_test_on_save_enabled(manifest):
    """True for a Python service that opted in with `dev.testOnSave` (boolean or dict with enabled: True); anything else stays off."""
    if not manifest or manifest.get("language", "bun") != "python":
        return False
    dev = manifest.get("dev")
    if type(dev) != "dict":
        return False
    test_on_save = dev.get("testOnSave")
    if test_on_save == True:
        return True
    if type(test_on_save) == "dict":
        return test_on_save.get("enabled", True) == True
    return False

def python_test_on_save_path(manifest):
    """The configured test path for pytest in a Python service, defaulting to 'tests'."""
    if not manifest:
        return "tests"
    dev = manifest.get("dev")
    if type(dev) == "dict":
        test_on_save = dev.get("testOnSave")
        if type(test_on_save) == "dict":
            path = test_on_save.get("path")
            if path and type(path) == "string":
                return path.strip()
    return "tests"
