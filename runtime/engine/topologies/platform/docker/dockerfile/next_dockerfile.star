# Dockerfile for a Next.js frontend (`framework: next`). Node image, not the Bun + nginx SPA image; see
# language_dockerfile.star for the other provider-owned runtimes.

load('../build/golden_image_constants.star', 'get_layer_reference')

BASE_PORT_FRONTEND = 3000

# Same RUN line as the backend templates in language_dockerfile.star (Starlark does not export underscored names).
_NEXT_CURL = """RUN apt-get update && apt-get install -y --no-install-recommends curl \\
  && rm -rf /var/lib/apt/lists/*
"""

# Next.js frontend (`framework: next`): a Node image, not the Bun + nginx SPA image. `development` runs `next dev` (what Tilt builds, with
# the sources live-updated into it); `production` is the standalone server `next build` writes. The engine's env file becomes `.env`,
# which Next loads in both modes, so next.config.mjs sees FLISK_BASE_PATH and the browser bundle gets NEXT_PUBLIC_API_URL.
# The Node runtime comes from the approved golden layer `l4-backend-node` when the golden image is enabled (the same
# `use_golden` switch the Bun generators use); otherwise it is the upstream node image.
# The `production` stage is the last one, so a plain `docker build` of the file also produces it.
# The upstream image appears literally in each FROM below, so a scanner that reads this file sees a digest-pinned image; the golden path
# swaps it for the golden layer reference.
_NODE_IMAGE = "node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392"

_NEXT = """# Generated by Flisk for a Next.js frontend. Do not edit; change service.json instead.
# The default is the upstream node image, pinned by digest like the backend Node template; the golden path replaces it.
FROM node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS base
ENV NEXT_TELEMETRY_DISABLED=1
# The golden runtime runs as a non-root user; install and build as root, then drop to {run_user} for the running stages.
USER root
WORKDIR /app/{res_path}

{curl}
COPY {res_path}/package.json {res_path}/package-lock.jso[n] ./
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi

COPY {res_path}/.autogenerated/.env.frontend.autogenerated ./.env
COPY {res_path}/next.config.mjs ./next.config.mjs
COPY {res_path}/tsconfig.json ./tsconfig.json
COPY {res_path}/public ./public
COPY {res_path}/src ./src

FROM base AS development
# WORKDIR is created by root, and next dev writes .next (and next-env.d.ts) inside it as {run_user}:
# without this the dev server dies with EACCES: mkdir '.next'. Give the run user the app folder.
ENV PORT={port} HOSTNAME=0.0.0.0
RUN chown -R {run_user}:{run_user} /app/{res_path}
USER {run_user}
EXPOSE {port}
CMD ["npx", "next", "dev", "--hostname", "0.0.0.0", "--port", "{port}"]

FROM base AS build
RUN npx next build

FROM node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS production
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT={port} HOSTNAME=0.0.0.0
WORKDIR /app/{res_path}
{curl}
COPY --from=build --chown={run_user}:{run_user} /app/{res_path}/.next/standalone ./
COPY --from=build --chown={run_user}:{run_user} /app/{res_path}/.next/static ./.next/static
COPY --from=build --chown={run_user}:{run_user} /app/{res_path}/public ./public
USER {run_user}
EXPOSE {port}
CMD ["node", "server.js"]
"""

def generate_next_dockerfile(res_path, port = BASE_PORT_FRONTEND, use_golden = True):
    """Dockerfile text for a Next.js frontend: `development` (next dev), `build`, and `production` (standalone server).

    With `use_golden` the base is the approved golden `l4-backend-node` layer (alpine, curl already present, non-root `app`);
    without it, the upstream node image (debian slim, which needs curl installed, non-root `node`).
    """
    if use_golden:
        run_user = 'app'
        curl = ''
    else:
        run_user = 'node'
        curl = _NEXT_CURL
    text = _NEXT.format(res_path = res_path, port = port, run_user = run_user, curl = curl)
    if use_golden:
        text = text.replace(_NODE_IMAGE, get_layer_reference('l4-backend-node'))
    return text
