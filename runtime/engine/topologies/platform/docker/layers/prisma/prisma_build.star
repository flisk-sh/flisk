# === INLINED CONSTANTS for pure extension loading ===
OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")
# === END INLINED CONSTANTS ===


"""
Prisma Build Layers - L3 Prisma Client Generation and Migration Engine

Encapsulates all Prisma-related Dockerfile instructions for the build stage:
- Client generation (`bunx prisma generate`)
- Output normalization (generated-client ↔ node_modules/.prisma/client)
- Default module shim for Prisma v7 / @prisma/client compatibility
- Migration engine stage for Prisma migrate deploy
"""

load('../l1_base_layers.star', 'BUN_BASE')
load('../l2_dependency_layers.star', 'normalize_res_path')
load('../../../../../../discovery/config.star', 'GLOBAL_CONFIG')
load('../../../../tilt/manifest/constants.star', 'AUTOGENERATED_CONFIG_PATHS')

load(
    './constants.star',
    'APP_BUN_STORE_DIR',
    'DEFAULT_GOLDEN_L3_MIGRATOR_IMAGE',
    'NODE_MODULES_DIR',
    'PRISMA_CONFIG_WORKDIR_PATH',
    'PRISMA_DIR_NAME',
    'PRISMA_GENERATE_RUN',
    'PRISMA_PACKAGE_NODE_MODULES_REL_PATH',
    'PRISMA_SCHEMA_PATH',
    'app_resource_dir',
    'prisma_normalize_output_block',
)

_docker_cfg = GLOBAL_CONFIG['docker']
GOLDEN_L3_MIGRATOR_IMAGE = _docker_cfg.get('golden_l3_migrator_image', DEFAULT_GOLDEN_L3_MIGRATOR_IMAGE)


def prisma_copy_instructions(res_path, has_prisma_config = False):
    """
    Generate Dockerfile COPY instructions for Prisma schema and config.

    Args:
        res_path: Resource path (service directory)
        has_prisma_config: Whether prisma.config.ts exists (Prisma v7)

    Returns:
        Dockerfile content string for copying Prisma files
    """
    # Normalize res_path for Docker COPY (must be relative to build context)
    res_path_rel = normalize_res_path(res_path)
    
    parts = "COPY " + res_path_rel + "/" + PRISMA_DIR_NAME + " ./" + PRISMA_DIR_NAME + "\n"
    if has_prisma_config:
        # Prisma v7 requires prisma.config.ts in CWD for correct client generation
        parts += "COPY " + res_path_rel + "/" + AUTOGENERATED_CONFIG_PATHS['prisma'] + " " + PRISMA_CONFIG_WORKDIR_PATH + "\n"
    return parts


def prisma_generate_instructions():
    """
    Generate Dockerfile RUN instruction for Prisma client generation.

    Returns:
        Dockerfile content string that runs `bunx prisma generate`
    """
    return PRISMA_GENERATE_RUN


def prisma_normalize_output():
    """
    Generate Dockerfile instructions to normalize Prisma output for both
    import styles: ../generated-client and node_modules/.prisma/client.

    Also creates a default.js shim required by @prisma/client v7 which
    resolves `.prisma/client/default` at runtime.

    Returns:
        Dockerfile content string for Prisma output normalization
    """
    return prisma_normalize_output_block(include_generated_client_export = True)


def prisma_cli_pin_step():
    """
    Dockerfile steps that make the Prisma CLI match the version of the installed @prisma/client.

    Shared by the migration stage and the backend's production-install stage, so a backend gets
    the pinned CLI without running a second install of its own.

    The step does nothing when the `bun install --production` before it already resolved `prisma` to that version, which is the
    usual case (both are in `dependencies` with the same range). It used to run `bun add` unconditionally, and `bun add` also
    installs devDependencies: biome, typescript, vitest, vite and their native binaries (about 330 MB) landed in the migrator's
    node_modules after a `--production` install (#3709).
    """
    return (
        "# Prisma CLI is often in devDependencies; install it explicitly without mutating manifest files.\n"
        + "# Pin it to the @prisma/client the install above resolved, not to the package.json range with its ^ dropped:\n"
        + "# ^7.5.0 resolves the client to the newest 7.x, and adding prisma@7.5.0 next to it downloaded a second Prisma\n"
        + "# (CLI, studio and client) and generated the client with an older CLI than the one it runs with.\n"
        + "# The add is skipped when the CLI is already at that version (the until condition); `bun add` would pull devDependencies back in.\n"
        + "RUN --mount=type=cache,target=/cache/bun,sharing=shared PRISMA_VERSION=$(sed -n 's/.*\"version\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' node_modules/@prisma/client/package.json 2>/dev/null | head -n 1) && { [ -n \"$PRISMA_VERSION\" ] || PRISMA_VERSION=$(sed -n 's/.*\"prisma\"[[:space:]]*:[[:space:]]*\"[~^]*\\([^\"]*\\)\".*/\\1/p' package.json | head -n 1); } && [ -n \"$PRISMA_VERSION\" ] && n=0 && until grep -Eq '\"version\"[[:space:]]*:[[:space:]]*\"'\"$PRISMA_VERSION\"'\"' node_modules/prisma/package.json 2>/dev/null || BUN_TMPDIR=/tmp BUN_INSTALL=/tmp/bun-install timeout 150 bun add --no-save --exact prisma@\"$PRISMA_VERSION\" --cache-dir=/cache/bun; do n=$((n+1)); [ \"$n\" -ge 3 ] && exit 1; echo \"bun add stalled or failed, retry $n of 2\"; done\n"
    )


def prisma_migrator_slim_step():
    """
    Dockerfile step that removes what the migrator never runs from its node_modules before the runtime stage copies them.

    `prisma migrate deploy` and `prisma generate` do not load the TypeScript native compiler, pglite, elkjs, react-dom or the
    query-plan executor, which Bun's install pulls in through Prisma's optional and peer dependencies (about 70 MB). The
    packages are moved aside, `prisma validate` runs against what is left, and they are moved back when it fails, so a
    Prisma release that starts to need one of them still builds a working migrator instead of a broken one.
    """
    return (
        "# Move aside what migrate deploy never loads; restore it if prisma validate then fails (a future Prisma may need it).\n"
        + "RUN set -e; mkdir -p /tmp/pruned; cd node_modules/.bun; "
        + "for p in @electric-sql+pglite@* @typescript+typescript-* typescript@* elkjs@* react-dom@* @prisma+query-plan-executor@*; do "
        + "[ -e \"$p\" ] && mv \"$p\" /tmp/pruned/ || true; done; cd ../..; "
        + "if ! DATABASE_URL=postgresql://u:p@localhost:5432/d node_modules/.bin/prisma validate >/dev/null 2>&1; then "
        + "echo 'prune broke prisma validate, restoring'; mv /tmp/pruned/* node_modules/.bun/ 2>/dev/null || true; fi; rm -rf /tmp/pruned\n"
    )


def L3_generate_migration_engine(res_path, use_golden = True):
    """
    Generate the migration engine layer for Prisma database migrations.

    Args:
        res_path: Resource path (service directory)
        use_golden: Whether to use golden L3-migrator image (default: True)

    Returns:
        Dockerfile content string for the l3_migration_build stage
    """
    # Normalize res_path for Docker COPY (must be relative to build context)
    res_path_rel = normalize_res_path(res_path)
    
    # Use golden L3-migrator image if enabled (Prisma pre-installed)
    base_image = GOLDEN_L3_MIGRATOR_IMAGE if use_golden else BUN_BASE
    app_res_path = app_resource_dir(res_path)

    return (
        "# ---- L3: migration_engine ----\n"
        + "FROM " + base_image + " AS l3_migration_build\n"
        + "WORKDIR " + app_res_path + "\n"
        + "# Copy manifest files for dependency installation\n"
        + "COPY " + res_path_rel + "/package.json ./package.json\n"
        + "COPY " + res_path_rel + "/" + PRISMA_DIR_NAME + " ./" + PRISMA_DIR_NAME + "\n"
        + "COPY " + res_path_rel + "/" + OUTPUT.AUTOGENERATED_FOLDER + "/.npmrc.docker.autogenerated .npmrc\n"
        + "COPY " + res_path_rel + "/" + OUTPUT.AUTOGENERATED_FOLDER + "/bunfig.docker.autogenerated.toml ./bunfig.toml\n"
        + "COPY bun.lock* ./\n"
        + "# Install runtime deps only for migrator image (skip test/dev toolchain)\n"
        + "# NOTE: keep bunfig.toml (it carries the project/@flisk-sh registry\n"
        + "# scopes pointing at Verdaccio) - deleting it forces scoped packages to fall\n"
        + "# back to the public npm registry and fail with ConnectionRefused/404.\n"
        + "# A Prisma engine download in a postinstall can stall with no timeout of its own and hold the build for\n"
        + "# many minutes, so each attempt is time-boxed and retried (the cache mount makes a retry fast).\n"
        + "# Keep the project's bun.lock (#4122): deleting it made bun resolve ~550 packages on every build and float\n"
        + "# @prisma/client off the locked version. The lockfile covers the whole workspace, so a plain\n"
        + "# `--frozen-lockfile` fails here (\"lockfile had changes\"): this image holds one workspace. `bun install\n"
        + "# --lockfile-only` first prunes it to this package, keeping the locked versions, then the install is frozen.\n"
        + "# Without a lockfile, one that does not list this workspace, or one this bun cannot read (written by a newer\n"
        + "# bun), the install resolves fresh as before, and says so in the build output.\n"
        + "RUN --mount=type=cache,target=/cache/bun,sharing=shared "
        + "if [ -f bun.lock ] && grep -qF '\"" + res_path_rel + "\": {' bun.lock "
        + "&& env -u CI BUN_TMPDIR=/tmp BUN_INSTALL=/tmp/bun-install timeout 150 bun install --lockfile-only --cache-dir=/cache/bun; then "
        + "mode=--frozen-lockfile; echo 'flisk: migrator install uses bun.lock (frozen)'; "
        + "else echo 'flisk: bun.lock missing, without " + res_path_rel + " or unreadable by this bun: resolving migrator dependencies without it'; "
        + "rm -f bun.lock bun.lockb; mode=--no-frozen-lockfile; fi; "
        + "n=0 && until env -u CI BUN_CONFIG_FROZEN_LOCKFILE=false BUN_TMPDIR=/tmp BUN_INSTALL=/tmp/bun-install timeout 150 bun install --production $mode --concurrent-scripts --cache-dir=/cache/bun; do n=$((n+1)); [ \"$n\" -ge 3 ] && exit 1; echo \"bun install stalled or failed, retry $n of 2\"; done\n"
        + prisma_cli_pin_step()
        + "# Generate Prisma client and normalize output location for runtime compatibility\n"
        + PRISMA_GENERATE_RUN
        + prisma_normalize_output_block(include_generated_client_export = False)
        + "RUN mkdir -p " + PRISMA_PACKAGE_NODE_MODULES_REL_PATH + "\n"
        + "RUN test -f " + PRISMA_SCHEMA_PATH + "\n"
        + prisma_migrator_slim_step()
    )

GLOBAL_CONFIG = {}
