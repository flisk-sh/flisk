# === INLINED CONSTANTS for pure extension loading ===
OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")
# === END INLINED CONSTANTS ===


load("../../common/utils_debug.star", "debug_log")
load("../../../../topologies/tilt/common/utils.star", "Utils")
load("../../../../topologies/tilt/manifest/constants.star", "GENERATED_CONFIG_FILENAMES")


# Check if verbose mode is enabled
_is_verbose = os.environ.get('TILT_LOG_LEVEL') == 'verbose'

# Module loaded - only show in verbose mode
if _is_verbose:
    print("🔥 frontend_tsconfig.star MODULE LOADED")

# =============================================================================
# Frontend TSConfig Generator
# =============================================================================

def generate_frontend_tsconfig(resource_path, write_fn, internal_deps=None, is_docker=True, framework='react'):
    """
    Generate tsconfig for frontend services.

    Args:
        resource_path: Path to the service directory
        write_fn: Write function for file output
        internal_deps: Optional internal dependencies map
        is_docker: Whether generating for Docker context
        framework: Frontend framework id; omitted in legacy manifests means React
    """
    # Check verbose mode
    is_verbose = os.environ.get('TILT_LOG_LEVEL') == 'verbose'
    
    # DEBUG: Only print when function is called in verbose mode
    if is_verbose:
        print("🎯 TSConfig.frontend called: service={}, is_docker={}, has_internal_deps={}".format(
            resource_path,
            is_docker,
            internal_deps != None
        ))
    # Local dev tsconfig lives in .autogenerated/, so "src" etc. are one level up (../src).
    # The Docker-variant tsconfig is written to the same .autogenerated/ path on disk, but the
    # Dockerfile COPYs it to the image's app root as ./tsconfig.json (sibling of ./src, not
    # nested under .autogenerated/) - so its own paths must be relative to that root instead,
    # or tsc reports "No inputs were found" because it looks one directory too high.
    src_prefix = "./" if is_docker else "../"
    paths = {
        "@/*": [src_prefix + "src/*"],
        "@/autogenerated/*": ["./.autogenerated/*"]
    }
    include_paths = [src_prefix + "src/**/*"]
    
    # =============================================================================
    # CRITICAL FIX: Only add path aliases for internal deps in LOCAL builds
    # =============================================================================
    # In Docker builds, these path aliases cause "Module not found" errors
    # because the source files aren't copied to the Docker context.
    # 
    # Docker builds should resolve from node_modules instead.
    # =============================================================================
    
    if internal_deps and not is_docker:
        # LOCAL BUILD: Can use path aliases to source for faster development
        sorted_deps = sorted(internal_deps.items())
        for pkg_name, src_path in sorted_deps:
            depth = len([segment for segment in resource_path.split('/') if segment])
            rel_to_root = "../" * depth
            paths[pkg_name] = [rel_to_root + src_path + "/src"]
            paths[pkg_name + "/*"] = [rel_to_root + src_path + "/src/*"]
    
    # If is_docker=True and internal_deps exist, warn about it
    if internal_deps and is_docker:
        if is_verbose:
            print("📝 Note: Excluding {} path aliases from Docker tsconfig for {}".format(
                len(internal_deps),
                resource_path
            ))
            print("   Docker build will resolve @{npm_scope}/* from node_modules")
    if framework not in ['react', 'vue', 'svelte', 'preact', 'lit', 'solid', 'qwik', 'vanilla', 'tanstack-router']:
        fail("Unknown frontend framework for TypeScript generation: " + str(framework))

    compiler_options = {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["dom", "dom.iterable", "esnext"],
        "paths": paths,
        "skipLibCheck": True,
        "strict": True,
        "esModuleInterop": True,
        "allowSyntheticDefaultImports": True,
        # "bun" (not "node"): matches backend_tsconfig.star - @types/bun is a direct
        # devDependency so it's always linked at the top level under any linker mode
        # (including Docker's isolated linker), while @types/node (when only pulled in
        # transitively, e.g. via bun-types) isn't hoisted under the isolated linker and
        # "types": ["node"] fails to resolve there even though it works locally.
        "types": ["node"],
    }
    if framework == 'react':
        compiler_options['jsx'] = 'react-jsx'
    elif framework == 'tanstack-router':
        compiler_options['jsx'] = 'react-jsx'
    elif framework == 'preact':
        compiler_options['jsx'] = 'react-jsx'
        compiler_options['jsxImportSource'] = 'preact'
    elif framework == 'qwik':
        compiler_options['jsx'] = 'react-jsx'
        compiler_options['jsxImportSource'] = '@builder.io/qwik'
    elif framework == 'solid':
        compiler_options['jsx'] = 'preserve'
        compiler_options['jsxImportSource'] = 'solid-js'

    content = {
        "compilerOptions": compiler_options,
        "exclude": [
            "node_modules",
            "dist",
            src_prefix + "__tests__/**/*",
            src_prefix + "**/*.test.ts",
            src_prefix + "**/tests/**/*",
            src_prefix + "**/*.steps.ts",
            src_prefix + "**/*.spec.ts"
        ],
        "include": include_paths
    }
    if is_docker:
        output_path = resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/' + GENERATED_CONFIG_FILENAMES['tsconfig_docker']
        debug_log("📝 Writing Docker tsconfig to: {}".format(output_path))
        write_fn(output_path, Utils.encode_json(content))
        debug_log("📝 Docker tsconfig write complete")
    else:
        output_path = resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/' + GENERATED_CONFIG_FILENAMES['tsconfig_local']
        debug_log("📝 Writing Local tsconfig to: {}".format(output_path))
        write_fn(output_path, Utils.encode_json(content))

DEBUG = {}
