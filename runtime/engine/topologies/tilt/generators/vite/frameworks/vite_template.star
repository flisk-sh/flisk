# One shared Vite frontend template for every framework.
#
# The eight framework templates used to be near-identical copies that differed
# only in the plugin import and the plugin call (React also carries a few
# React-only build settings). A fix to a shared block landed in one file and
# silently missed the other seven, so the shared blocks now exist exactly once,
# here, and each framework is a data-table entry in frontend.star. Adding a
# framework means adding one table entry, not a new template file.
#
# The builder returns {'dev': ..., 'build': ...} template strings with the
# same {header}/{base_path}/{port}/{hmr_port}/{proxy_config}/
# {internal_aliases}/{optimize_deps_include} placeholders frontend.star fills
# in. The generated configs are byte-identical to the old per-framework files.

def vite_frontend_template(plugin_import, plugin_call, alias_comment = "", build_plugin_call = None, build_optimize_deps = None, build_esbuild = "", build_manual_chunks_comment = "", build_alias_extra = ""):
    """Build the dev and build Vite config templates for one framework.

    Args:
        plugin_import: the framework plugin import line ("" when the
            framework needs no plugin, e.g. lit/vanilla).
        plugin_call: the dev plugin call ("" for no plugin).
        alias_comment: extra comment line(s) at the top of the resolve.alias
            block, each line ending in "\\n" (React only).
        build_plugin_call: the build plugin call; defaults to plugin_call.
            React passes the multi-line jsxRuntime call here.
        build_optimize_deps: the body of the build optimizeDeps block;
            defaults to the single include line. React passes its longer
            include list plus esbuildOptions here.
        build_esbuild: a build-only esbuild block, "" unless the framework
            needs one (React only).
        build_manual_chunks_comment: comment line above manualChunks in the
            build config, "" unless the framework needs one (React only).
        build_alias_extra: extra alias lines at the end of the build alias
            block, each line ending in "\\n" (React only).
    """
    if build_plugin_call == None:
        build_plugin_call = plugin_call
    if build_optimize_deps == None:
        build_optimize_deps = "    include: [{optimize_deps_include}],\n"
    if plugin_import == "":
        import_line = ""
    else:
        import_line = plugin_import + "\n"

    dev = """{header}
import {{ resolve }} from 'node:path';
""" + import_line + """import {{ defineConfig }} from 'vite';

export default defineConfig({{
  base: '{base_path}',
  build: {{
    cssCodeSplit: false,
    minify: false,
    modulePreload: false,
    rollupOptions: {{
      output: {{
        entryFileNames: '[name].js',
        format: 'esm',
      }},
    }},
    target: 'esnext',
  }},
  define: {{
    global: 'globalThis',
  }},
  optimizeDeps: {{
    include: [{optimize_deps_include}],
  }},
  plugins: [""" + plugin_call + """],
  preview: {{
    host: '0.0.0.0',
    port: {port},
  }},
  resolve: {{
    alias: {{
""" + alias_comment + """      '@/autogenerated': resolve(__dirname),
      '@': resolve(__dirname, '../src'),
      'set-cookie-parser': resolve(__dirname, '../src/utils/empty-module.js'),
{internal_aliases}
    }},
  }},
  server: {{
    host: '0.0.0.0',
    port: {port},
    hmr: {{
      port: {hmr_port},
    }},
{proxy_config}
  }},
}});
"""

    build = """{header}
import {{ resolve }} from 'node:path';
""" + import_line + """import {{ defineConfig }} from 'vite';

export default defineConfig({{
  mode: 'production',
  base: '{base_path}',
  build: {{
    cssCodeSplit: false,
    minify: true,
    modulePreload: false,
    rollupOptions: {{
      output: {{
        entryFileNames: '[name].js',
        format: 'esm',
""" + build_manual_chunks_comment + """        manualChunks: undefined,
      }},
    }},
    target: 'esnext',
  }},
  define: {{
    global: 'globalThis',
    __DEV__: 'false',
    'process.env.NODE_ENV': '"production"',
  }},
""" + build_esbuild + """  optimizeDeps: {{
""" + build_optimize_deps + """  }},
  plugins: [""" + build_plugin_call + """],
  resolve: {{
    alias: {{
""" + alias_comment + """      '@/autogenerated': resolve(__dirname),
      '@': resolve(__dirname, '../src'),
      'set-cookie-parser': resolve(__dirname, '../src/utils/empty-module.js'),
""" + build_alias_extra + """    }},
    conditions: ['browser', 'import', 'module', 'es2020', 'default'],
    mainFields: ['browser', 'module', 'jsnext:main', 'jsnext', 'main'],
  }},
}});
"""

    return {'dev': dev, 'build': build}
