# =============================================================================
# ⚡ TILT SDK - VITE FRONTEND GENERATOR

# === INLINED CONSTANTS for pure extension loading ===
BASE_PORT_FRONTEND = 3000
BASE_PORT_BACKEND = 4000
OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")
# === END INLINED CONSTANTS ===


load('../../../../topologies/tilt/manifest/constants.star', 'GENERATED_CONFIG_FILENAMES')
# =============================================================================
# Path: .tilt/providers/vite/frontend.star
# Purpose: Vite config generator for Frontend services
# =============================================================================


load('./frameworks/vite_template.star', 'vite_frontend_template')
load('../../../platform/docker/networking/api_path_constants.star', 'get_frontend_base_path')
load('./helpers.star', 
    'build_header', 
    'generate_frontend_internal_aliases', 
    'generate_frontend_optimize_deps', 
    'generate_proxy_block'
)

# Constants for output paths
VITE_FRONTEND_CONFIG_PATH = '/' + OUTPUT.AUTOGENERATED_FOLDER + '/' + GENERATED_CONFIG_FILENAMES['vite_frontend']
VITE_FRONTEND_BUILD_CONFIG_PATH = '/' + OUTPUT.AUTOGENERATED_FOLDER + '/' + GENERATED_CONFIG_FILENAMES['vite_build']

# React is the only framework with extras beyond the plugin import and call:
# an alias-order comment, a multi-line build plugin call with jsxRuntime
# options, a longer build optimizeDeps list, a build esbuild block, and an
# extra build alias. The other seven frameworks need just the two slots.
_REACT_TEMPLATES = vite_frontend_template(
    plugin_import = "import react from '@vitejs/plugin-react';",
    plugin_call = "react()",
    alias_comment = "      // 🎯 IMPORTANT: Order matters! More specific aliases must come FIRST\n",
    build_plugin_call = """
    react({{
      // Force automatic JSX runtime in production mode
      jsxRuntime: 'automatic',
      jsxImportSource: 'react',
    }}),
  """,
    build_optimize_deps = """    include: [
      'react',
      'react-dom',
      'react-dom/client',
      'react/jsx-runtime',
      '@tanstack/react-query',
      // Internal packages (auto-generated)
      {optimize_deps_include}
    ],
    esbuildOptions: {{
      format: 'esm',
      target: 'esnext',
      // Use production JSX runtime
      jsx: 'automatic',
      jsxImportSource: 'react',
      jsxDev: false,
    }},
""",
    build_esbuild = """  esbuild: {{
    // Force production JSX runtime
    jsx: 'automatic',
    jsxImportSource: 'react',
    // CRITICAL: Disable development JSX (jsxDEV) for Vite 8 + Rolldown compatibility
    jsxDev: false,
  }},
""",
    build_manual_chunks_comment = "        // Inline all node_modules to prevent lazy dynamic imports for CJS modules\n",
    build_alias_extra = """      // Force production JSX runtime - alias dev runtime to production runtime
      'react/jsx-dev-runtime': 'react/jsx-runtime',
""",
)

# One entry per framework: the plugin import line and the plugin call are the
# only per-framework data (plus React's extras above). Adding a framework
# means adding one entry here, not a new template file.
_FRAMEWORK_TEMPLATES = {
    'react': _REACT_TEMPLATES,
    'vue': vite_frontend_template(
        plugin_import = "import vue from '@vitejs/plugin-vue';",
        plugin_call = "vue()",
    ),
    'svelte': vite_frontend_template(
        plugin_import = "import {{ svelte }} from '@sveltejs/vite-plugin-svelte';",
        plugin_call = "svelte()",
    ),
    'preact': vite_frontend_template(
        plugin_import = "import preact from '@preact/preset-vite';",
        plugin_call = "preact()",
    ),
    'lit': vite_frontend_template(plugin_import = "", plugin_call = ""),
    'solid': vite_frontend_template(
        plugin_import = "import solid from 'vite-plugin-solid';",
        plugin_call = "solid()",
    ),
    'qwik': vite_frontend_template(
        plugin_import = "import {{ qwikVite }} from '@builder.io/qwik/optimizer';",
        plugin_call = "qwikVite({{ csr: true }})",
    ),
    'vanilla': vite_frontend_template(plugin_import = "", plugin_call = ""),
    # A React SPA with TanStack Router: same plugin, same config, only the app code differs.
    'tanstack-router': _REACT_TEMPLATES,
}

def _normalize_vite_base_path(base_path):
    """Vite subpath deploys are more reliable with a trailing slash."""
    if not base_path:
        return '/'
    if not base_path.startswith('/'):
        base_path = '/' + base_path
    if base_path != '/' and not base_path.endswith('/'):
        base_path = base_path + '/'
    return base_path

def generate_frontend(manifest, backend_manifest=None, write_fn=None):
    """
    Generate dev and build Vite configs under the resource's .autogenerated/ directory.
    
    Features:
    - Auto-proxy to backend based on backend manifest port
    - HMR configuration with correct ports
    - Base path configuration
    - TypeScript path aliases
    - 🔥 Auto-generated internal dependency aliases from package.json
    - 🔥 optimizeDeps.include for faster dev startup
    """
    if manifest.get('appType') != 'frontend':
        fail("Vite.frontend() requires a frontend manifest, got: " + manifest.get('appType', 'unknown'))

    framework_id = manifest.get('framework', 'react')
    framework_templates = _FRAMEWORK_TEMPLATES.get(framework_id)
    if framework_templates == None:
        fail("Unknown frontend framework for Vite generation: " + str(framework_id))
    
    resource_path = manifest.get('_resource_path', '')
    stack = manifest.get('stack', 'app')
    port = manifest.get('port', BASE_PORT_FRONTEND)
    hmr_port = port + 1000  # HMR port is always port + 1000
    app_name = manifest.get('appName', 'unknown')
    base_path = get_frontend_base_path(manifest, app_name)
    vite_base_path = _normalize_vite_base_path(base_path)

    backend_port = BASE_PORT_BACKEND
    if backend_manifest:
        backend_port = backend_manifest.get('port', BASE_PORT_BACKEND)

    # Use traefik pathPrefix for API base path (modern pattern)
    traefik_config = manifest.get('traefik', {})
    api_base_path = traefik_config.get('pathPrefix', '/api')

    proxy_config = generate_proxy_block(api_base_path, backend_port, [], stack)
    header = build_header('Vite.frontend()', app_name)
    # Config is written under .autogenerated/, so aliases need one extra ".." level.
    internal_aliases = generate_frontend_internal_aliases(resource_path, manifest, 1)
    optimize_deps_include = generate_frontend_optimize_deps(manifest)
    
    config = framework_templates['dev'].format(
        header=header,
        base_path=vite_base_path,
        port=port,
        hmr_port=hmr_port,
        proxy_config=proxy_config,
        internal_aliases=internal_aliases,
        optimize_deps_include=optimize_deps_include,
    )

    build_cfg_header = build_header('Vite.frontend()', app_name, 'Build-only Vite config')
    build_config = framework_templates['build'].format(
        header=build_cfg_header,
        base_path=vite_base_path,
        optimize_deps_include=optimize_deps_include,
    )
    
    if write_fn:
        write_fn(resource_path + VITE_FRONTEND_CONFIG_PATH, config)
        write_fn(resource_path + VITE_FRONTEND_BUILD_CONFIG_PATH, build_config)
    
    return config
