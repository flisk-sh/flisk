# === INLINED CONSTANTS for pure extension loading ===
BASE_PORT_FRONTEND = 3000
BASE_PORT_BACKEND = 4000
OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")
# === END INLINED CONSTANTS ===


load("../../../../platform/docker/auth/auth.star", "AuthConfig")
load("../../../../platform/docker/networking/traefik_helpers.star", "get_api_path")
load("./dependencies/resolver.star", "resolve_backend_api_path", "resolve_dependency_api_path", "resolve_dependency_provides", "resolve_resource_port")
load("../../../../platform/docker/secrets/providers.star", "provider_env_file_lines")
load("../../../common/dependencies.star", "declared_dependencies")
load("../../../../platform/docker/networking/api_path_constants.star", "get_frontend_base_path")
load("../../../../platform/docker/constants.star", "PlatformDockerConstants")
load("../../../../platform/docker/compose/byo_shared_database.star", "byo_wants_shared_database")



def _normalize_dependency_path(dependency):
    dep = str(dependency).strip()
    if not dep:
        return ''

    if dep.endswith('-management-backend'):
        return dep.replace('-management-backend', '')

    if dep.endswith('-backend'):
        return dep[:-8]

    if dep.endswith('-frontend'):
        return dep[:-9]

    return dep


def _dependency_env_key(dependency):
    dep = str(dependency).upper()
    key = ''
    for i in range(len(dep)):
        char = dep[i]
        if (char >= 'A' and char <= 'Z') or (char >= '0' and char <= '9'):
            key += char
        else:
            key += '_'
    while '__' in key:
        key = key.replace('__', '_')
    return key.strip('_')


def _build_dependency_env_lines(manifest):
    dependencies = declared_dependencies(manifest)
    if not dependencies:
        return ''

    # Deduplicate while preserving first-seen order.
    seen = {}
    ordered = []
    for dep in dependencies:
        # Only a backend-side service has an API to call: a typo, a stack, the shared Postgres or a frontend gets no line.
        if resolve_dependency_api_path(dep) == None:
            continue
        dep_path = _normalize_dependency_path(dep)
        if dep_path and not seen.get(dep_path, False):
            seen[dep_path] = True
            ordered.append((dep_path, dep))

    if not ordered:
        return ''

    lines = '\n# Dependency API URLs (the route Traefik serves each dependency on)\n'
    for dep_path, dep in ordered:
        dep_key = _dependency_env_key(dep_path)
        dep_api_path = resolve_dependency_api_path(dep)
        lines += 'VITE_{dep_key}_API_URL=http://{local_domain}{dep_api_path}\n'.format(
            dep_key=dep_key,
            dep_api_path=dep_api_path,
            local_domain=PlatformDockerConstants.API_LOCAL_DOMAIN,
        )
    return lines


# A `provides` name or value: an environment variable name, and a URL with no quoting needed (no secret, no `$`).
_PROVIDES_NAME_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_'
_PROVIDES_VALUE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-./:@%+=,'


def _only_chars(text, chars):
    if type(text) != 'string' or not text:
        return False
    for c in text.elems():
        if c not in chars:
            return False
    return True


def _dependency_provides_lines(manifest):
    """Env lines for the `provides` settings of each dependency (a Redis preset's REDIS_URL), in dependsOn order.

    A service's own `params` win over a dependency's setting of the same name. Mirrors providesErrors in
    cli/src/utils/service-manifest.ts.
    """
    params = manifest.get('params', manifest.get('envVars', {})) or {}
    seen = {}
    lines = ''
    for dep, provides in resolve_dependency_provides(manifest):
        if type(provides) != 'dict':
            fail("MANIFEST ERROR: 'provides' of {} must be an object such as {{\"REDIS_URL\": \"redis://cache:6379\"}}".format(dep))
        for key in sorted(provides.keys()):
            value = provides[key]
            if not _only_chars(key, _PROVIDES_NAME_CHARS) or key[0].isdigit():
                fail("MANIFEST ERROR: 'provides' of {} has an invalid name '{}'".format(dep, key))
            if not _only_chars(value, _PROVIDES_VALUE_CHARS):
                fail("MANIFEST ERROR: 'provides.{}' of {} must be a URL or value without spaces, quotes or $".format(key, dep))
            if key in params or seen.get(key):
                continue
            seen[key] = True
            lines += key + '=' + value + '\n'
    if not lines:
        return ''
    return '\n# Provided by dependencies (their service.json `provides`)\n' + lines


# Characters that can appear in a dotenv value without quoting.
_ENV_BARE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-./:@%+=,'


def _format_env_value(value):
    """Format a param value so the generated file stays valid dotenv.

    A plain value stays bare. Anything else (a space, `#`, `$`, a quote, a backslash, a newline, or an empty string) is wrapped in double
    quotes with backslash, quote and newline escaped, which is how dotenv parsers (including Docker Compose's) read it back.

    `$` is written as `$$`: Docker Compose expands `$NAME` and `${NAME}` in env files, so an unescaped dollar would silently pick up
    some other variable (checked in a real container: "price $$FOO" arrives as the literal `price $FOO`).
    """
    text = str(value)
    bare = text != ''
    for i in range(len(text)):
        if text[i] not in _ENV_BARE_CHARS:
            bare = False
            break
    if bare:
        return text

    escaped = text.replace('\\', '\\\\').replace('"', '\\"').replace('$', '$$').replace('\r', '\\r').replace('\n', '\\n')
    return '"' + escaped + '"'


def _uses_prisma(manifest):
    """Prisma is opt-in: an explicit usePrisma, or `prisma` in featuresEnabled (the same rule the Dockerfile generator uses)."""
    if manifest.get('usePrisma'):
        return True
    return 'prisma' in manifest.get('featuresEnabled', [])


def _uses_drizzle(manifest):
    """Drizzle reads DATABASE_URL at runtime. It has no migrator, so only the connection string is written."""
    return 'drizzle' in manifest.get('featuresEnabled', [])


def _generate_params_env(manifest, backend_manifest=None, write_fn=None):
    """Generate params (non-secret) environment variables from manifest.

    This generates config like BASE_URL, PORT, etc. - NEVER secrets. The file is generated and verified by `flisk config verify`, so
    nothing secret may be written here: the JWT secret and `secrets.required` / `secrets.optional` reach the container from the
    project `.env` through the Compose entry instead.

    Args:
        manifest: Service manifest dict with configuration
        backend_manifest: Optional backend manifest for frontend services
        write_fn: Optional write function for file output (callable)

    Returns:
        str: Generated environment file content
    """
    resource_path = manifest.get('_resource_path', '')
    app_type = manifest.get('appType', 'backend')
    stack = manifest.get('stack', 'app')
    port = manifest.get('port', BASE_PORT_FRONTEND)
    # Use standardized API path from traefik helpers
    api_path = get_api_path(stack)
    # Traefik routes /api/<stack>-management only on api.<project>.localhost (see traefik.star), so the URL uses that host.
    api_url = 'http://' + PlatformDockerConstants.API_LOCAL_DOMAIN + api_path
    target_filename = '/' + OUTPUT.AUTOGENERATED_FOLDER + '/.env.backend.autogenerated'
    
    # Auth configuration: the same builder Compose uses, so the two outputs cannot disagree. A missing value is None and AuthConfig
    # treats None as "use the default". `jwtSecret` is deliberately not read: a secret in a committed service.json would be copied into
    # a generated file, so the secret comes from the project .env instead.
    auth_config = AuthConfig.from_manifest(manifest)
    
    if app_type == 'frontend':
        backend_port = backend_manifest.get('port', BASE_PORT_BACKEND) if backend_manifest else BASE_PORT_BACKEND
        backend_name = manifest.get('backendName', stack + '-backend')
        target_filename = '/' + OUTPUT.AUTOGENERATED_FOLDER + '/.env.frontend.autogenerated'
        # The browser calls the frontend's own backend; the stack-management route only serves flisk's own API.
        frontend_api_url = 'http://' + PlatformDockerConstants.API_LOCAL_DOMAIN + (resolve_backend_api_path(manifest) or api_path)
        
        # Shared with the Traefik route and the Vite `base` -- see get_frontend_base_path.
        base_path = get_frontend_base_path(manifest, manifest.get('appName'))
        public_url = 'http://' + PlatformDockerConstants.LOCAL_DOMAIN + base_path
        
        content = """# Generated by Tilt SDK - DO NOT EDIT
# Frontend Environment Variables
VITE_API_PORT={backend_port}
VITE_API_URL={api_url}
VITE_BACKEND_NAME={backend_name}
PUBLIC_URL={public_url}
""".format(
    backend_port=backend_port,
    api_url=frontend_api_url,
    backend_name=backend_name,
    public_url=public_url,
)
        if manifest.get('framework') == 'next':
            # Next.js reads NEXT_PUBLIC_* (inlined into the browser bundle) and next.config.mjs reads FLISK_BASE_PATH.
            # The generated Dockerfile copies this file to .env, which `next dev` and `next build` both load.
            content += """NEXT_PUBLIC_API_URL={api_url}
FLISK_BASE_PATH={base_path}
""".format(api_url=frontend_api_url, base_path=base_path)
        content += _build_dependency_env_lines(manifest)
    else:
        db_name = manifest.get('databaseName', PlatformDockerConstants.get_db_name(stack))
        
        # A bring-your-own container runs an image Flisk did not build: it gets the name of the shared database only when it asks for
        # it (#3026, the same rule as DATABASE_URL in the Compose entry), not a name for a database that does not exist.
        database_line = ''
        if app_type != 'bring-your-own' or byo_wants_shared_database(manifest):
            database_line = 'DATABASE_NAME=' + db_name + '\n'
        content = """# Generated by Tilt SDK - DO NOT EDIT
# Backend Environment Variables
PORT={port}
{database_line}API_URL={api_url}
""".format(port=port, database_line=database_line, api_url=api_url)
        
        if _uses_prisma(manifest):
            content += """
# Prisma
DATABASE_URL=""" + PlatformDockerConstants.get_database_url_for_env(db_name) + """
"""
        elif _uses_drizzle(manifest):
            content += """
# Drizzle
DATABASE_URL=""" + PlatformDockerConstants.get_database_url_for_env(db_name) + """
"""
        
        # Add authentication configuration using centralized auth utilities
        content += AuthConfig.generate_env_file_auth_section(auth_config)
        content += _dependency_provides_lines(manifest)
        content += provider_env_file_lines(manifest, resolve_resource_port)
    
    # Add params (non-secret config variables)
    # NOTE: Secrets are NEVER added here (see the docstring).
    params = manifest.get('params', manifest.get('envVars', {}))  # Fallback to envVars during migration
    if params:
        content += '\n# Params (non-secret config)\n'
        # Sort keys for deterministic output to avoid unnecessary file rewrites.
        for key in sorted(params.keys()):
            value = params.get(key)
            content += key + '=' + _format_env_value(value) + '\n'
    
    if write_fn and resource_path:
        write_fn(resource_path + target_filename, content)
    
    return content


EnvGenerators = struct(
    generate_params_env = _generate_params_env,
    # Legacy alias for backward compatibility during migration
    generate_env_file = _generate_params_env,
)
