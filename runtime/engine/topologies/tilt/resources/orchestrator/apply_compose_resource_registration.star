# Public wrappers for shared platform Postgres helpers. Starlark `load` does not
# re-export loaded names. Canonical list + predicates live in
# shared-platform-postgres.star — do not hardcode a second copy of the names here.

def is_shared_platform_postgres_dependency(name):
    """True when a dependsOn name is one of the shared platform Postgres aliases."""
    return _is_shared_platform_postgres_dependency(name)


def manifest_needs_shared_platform_postgres(manifest, database_names=None):
    """True when a manifest is a database resource, or its dependsOn lists postgres, database-management or a database resource."""
    return _manifest_needs_shared_platform_postgres(manifest, database_names)


def _is_database_resource(name, all_services_map):
    """True when `name` is the appName of a discovered `database` resource (the project's Postgres, declared in a service.json)."""
    service = (all_services_map or {}).get(name)
    if not service:
        return False
    for res in service.get('resources', []):
        if res.get('name', '') == name and _is_database_manifest(res.get('_manifest', {}) or {}):
            return True
    return False


def database_resource_names(all_services_map):
    """The appNames of every discovered `database` resource."""
    names = []
    for svc in (all_services_map or {}).values():
        for res in svc.get('resources', []):
            name = res.get('name', '')
            if name and name not in names and _is_database_manifest(res.get('_manifest', {}) or {}):
                names.append(name)
    return names


def project_imports_own_postgres_container(all_services_map):
    """True when a discovered resource named `postgres` runs as a container of its own, so `dependsOn: postgres` names that container."""
    for svc in (all_services_map or {}).values():
        for res in svc.get('resources', []):
            if res.get('name', '') == 'postgres' and (res.get('_manifest', {}) or {}).get('appType', 'backend') not in ['database', 'library', 'sdk', 'infra']:
                return True
    return False


def selected_for_shared_platform_postgres(name, ctx):
    """Use the same focus selection later passed to set_enabled_resources."""
    if not ctx.get('focus_mode', False):
        return True
    return name in (ctx.get('focus_enabled_resources') or [])


def force_start_shared_platform_postgres_once(ctx, should_enable, resource_name=""):
    """Force-start shared platform Postgres at most once per Tiltfile evaluation.

    `register_compose_resources` runs per stack and can see unselected nested
    services; two selected services that both `dependsOn` Postgres would otherwise call
    `Infra.force_start_postgres` twice (docker_compose + dc_resource each time).
    Module-level mutable flags are unusable — Tilt freezes Starlark globals — so
    the guard lives on `ctx`, a dict the Tiltfile already owns for this run.

    Returns True when this call performed the force-start, False when it skipped
    (already started this run, or database-management is already on).
    """
    if ctx.get('_shared_platform_postgres_force_started', False):
        debug_log("COMPOSE: shared platform Postgres already force-started this run; skip for '{}'".format(resource_name))
        return False
    if should_enable('database-management'):
        return False
    project_root_for_env = ctx.get('project_root', '')
    root_prefix = (project_root_for_env + '/') if project_root_for_env else ''
    env_candidate = project_env_file(project_root_for_env)
    env_file = _env_file_if_exists(env_candidate)
    write_fn = ctx.get('write_file', None)
    if write_fn == None:
        fail("dependsOn postgres/database-management on selected resource '{}' requires ctx.write_file to materialize services/platform/database-management/docker-compose.yml".format(resource_name))
    debug_log("COMPOSE: force-starting shared platform Postgres once (selected '{}' dependsOn)".format(resource_name))
    Infra.force_start_postgres(should_enable, root_prefix=root_prefix, env_file=env_file, write_fn=write_fn)
    ctx['_shared_platform_postgres_force_started'] = True
    return True


def _env_file_if_exists(env_file):
    """.env is gitignored (no .env.example shipped) across every Flisk example repo, so a
    fresh clone must not hard-require it: docker_compose()'s env_file kwarg type-checks as
    path|string (rejects None), so only return a path when the file actually exists."""
    exists = file_exists(env_file)
    return env_file if exists else None


def compose_files_declare_service(resource_config, ctx, service_name):
    """True when a Compose file the stack loads itself (compose_files) declares a service named `service_name`."""
    project_root = ctx.get('project_root', '')
    resource_path = resource_config.get('path', '')
    for compose_file in resource_config.get('compose_files', []):
        if compose_file == '.autogenerated/docker-compose.app.autogenerated.yml':
            continue
        path = (project_root + '/' if project_root else '') + resource_path + '/' + compose_file
        if not file_exists(path):
            continue
        doc = read_yaml(path, default={})
        services = doc.get('services', {}) if type(doc) == 'dict' else {}
        if type(services) == 'dict' and service_name in services:
            return True
    return False


def stack_has_own_postgres_container(resource_config, resource_manifests):
    """True when the stack imports its own `postgres` container (an app resource, not the shared `database` resource).

    `flisk import` writes a Compose `postgres` service as its own resource, which lands in the generated app Compose file as
    the `postgres` dc_resource. Shared platform Postgres must not register a second one.
    """
    for resource in resource_config.get('resources', []):
        if resource.get('name', '') != 'postgres':
            continue
        app_type = resource_manifests.get('postgres', {}).get('appType', 'backend')
        if app_type != 'database':
            return True
    return False


def _docker_compose_app(compose_paths, project_name, env_file):
    resolved_env_file = _env_file_if_exists(env_file)
    if resolved_env_file:
        docker_compose(compose_paths, project_name=project_name, env_file=resolved_env_file)
    else:
        docker_compose(compose_paths, project_name=project_name)


def _stack_uses_golden_image(resource_config, resource_manifests):
    """Whether any resource of the stack builds from the shared golden base images.

    A bring-your-own resource builds its own Dockerfile and never uses them, and libraries, SDKs and
    infra resources build no image. A stack made only of those must not wait for the golden build.
    """
    for resource in resource_config.get('resources', []):
        app_type = resource_manifests.get(resource['name'], {}).get('appType', 'backend')
        if app_type not in ['bring-your-own', 'library', 'sdk', 'infra', 'database']:
            return True
    return False


def _stack_waits_for_golden_step(resource_config, resource_manifests, all_services_map):
    """Whether the stack's resources start after the golden step: it uses the images, or it pulls images while another stack does.

    The golden step untags and prunes images, and on the containerd image store that fails a `docker compose` pull running beside
    it ("failed to extract layer"). In a project where nothing uses the golden images the step touches no image, so nothing waits.
    """
    if _stack_uses_golden_image(resource_config, resource_manifests):
        return True
    has_byo = False
    for resource in resource_config.get('resources', []):
        if resource_manifests.get(resource['name'], {}).get('appType', 'backend') == 'bring-your-own':
            has_byo = True
    if not has_byo:
        return False
    for svc in (all_services_map or {}).values():
        for res in svc.get('resources', []):
            if (res.get('_manifest', {}) or {}).get('appType', 'backend') not in ['bring-your-own', 'library', 'sdk', 'infra', 'database']:
                return True
    return False


def _build_infra_dependencies(resource_name, should_enable, ctx, has_backend=False, uses_golden_image=True):
    infra_deps = []
    if should_enable('database-management'):
        infra_deps.append('postgres')
        if has_backend:
            infra_deps.append('provision-db-' + resource_name)
    if should_enable(PlatformDockerConstants.VERDACCIO_RESOURCE_NAME):
        project_root = ctx.get('project_root', '')
        verdaccio_compose = ((project_root.rstrip('/') + '/') if project_root else '') + 'docker-compose.verdaccio.yml'
        if file_exists(verdaccio_compose):
            infra_deps.append(PlatformDockerConstants.VERDACCIO_RESOURCE_NAME)
    if uses_golden_image and should_enable('golden-image') and ctx.get('golden_image_resource'):
        infra_deps.append(ctx['golden_image_resource'])
    return infra_deps


def _resolve_dependency_to_resource(dep_name, all_services_map):
    """
    Resolve a short dependency name (e.g., 'identity') to the full YAML resource name.

    The discovery registry creates YAML resources with names like:
    - 'identity-management-backend-yaml' for identity backend
    - 'api-gateway-yaml' for api-gateway

    But manifests reference them as short names like 'identity' or 'api-gateway'.

    Shared platform Postgres aliases (`postgres`, `database-management`) resolve
    to the literal Tilt resource `postgres` in BOTH feature states — they must
    NOT fall through to `postgres-yaml` or any other name.
    """
    # Shared platform Postgres: exact names only (typos stay on the normal path).
    if is_shared_platform_postgres_dependency(dep_name) or _is_database_resource(dep_name, all_services_map):
        return 'postgres'

    # Check if already a full YAML resource name
    if dep_name in all_services_map:
        return dep_name

    # Try with -yaml suffix (for resources already resolved)
    yaml_name = dep_name + '-yaml'
    if yaml_name in all_services_map:
        return yaml_name

    # Try to find matching service by stack/short name
    for resource_name, resource_info in all_services_map.items():
        # Check if this service's stack matches the dependency
        resource_domain = resource_info.get('stack', '')
        if resource_domain == dep_name:
            # Return the first resource of this service with -yaml suffix
            resources = resource_info.get('resources', [])
            if resources:
                # Prefer backend resources over frontends
                for res in resources:
                    if not res.get('frontend', False):
                        return res['name'] + '-yaml'
                # Fallback to first resource
                return resources[0]['name'] + '-yaml'

    # Try pattern matching: identity -> identity-*-yaml
    for resource_name in all_services_map.keys():
        if resource_name.startswith(dep_name + '-') and resource_name.endswith('-yaml'):
            return resource_name

    # Return original with -yaml suffix as last resort
    return dep_name + '-yaml'


# App types the registration loop skips (see register_compose_resources): they get no Tilt resource, so nothing can wait for them
# and their own dependsOn never reaches the graph.
_UNREGISTERED_APP_TYPES = ['library', 'sdk', 'infra', 'database']


def _is_registered_resource(res):
    """True when the registration loop creates a Tilt resource for this discovered resource."""
    app_type = (res.get('_manifest', {}) or {}).get('appType', 'backend')
    return app_type not in _UNREGISTERED_APP_TYPES


def _is_unregistered_resource(name, all_services_map):
    """True when `name` is a discovered resource of a type the registration loop skips (library, sdk, infra).

    Such a resource has no Tilt resource under its own name (a library's only resource is `<name>-yaml`, which also does not
    exist for the skipped types), so a dependsOn on it can never become a wait edge; Tilt would only print "dependency ignored".
    """
    service = (all_services_map or {}).get(name)
    if not service:
        return False
    for res in service.get('resources', []):
        if res.get('name', '') == name:
            return not _is_registered_resource(res)
    return False


def _is_known_resource(name, all_services_map):
    """True when `name` is the name of a resource (a runnable service), not of a stack or an alias."""
    service = (all_services_map or {}).get(name)
    if not service:
        return False
    for res in service.get('resources', []):
        if res.get('name', '') == name:
            return True
    return False


def _resolve_dependency_to_resources(dep_name, all_services_map):
    """Resolve one dependsOn entry to the Tilt resources it makes a service wait for.

    - the shared platform Postgres names, and the appName of a `database` resource -> `postgres`
    - a resource (service) name -> that resource
    - a stack name -> every backend-side resource of that stack. Frontends are left out, as in the `--focus` closure
      (get_all_needed_services), so a service that depends on a stack never waits for the stack's UI.
    - anything else -> [] (a typo; `flisk up` and `flisk config verify` name it)
    """
    if is_shared_platform_postgres_dependency(dep_name) or _is_database_resource(dep_name, all_services_map):
        return ['postgres']
    all_services_map = all_services_map or {}
    if _is_known_resource(dep_name, all_services_map):
        # A library, sdk or infra resource gets no Tilt resource, so there is nothing to wait for.
        return [] if _is_unregistered_resource(dep_name, all_services_map) else [dep_name]
    names = []
    for service in all_services_map.values():
        if service.get('stack', '') != dep_name and service.get('name', '') != dep_name:
            continue
        for res in service.get('resources', []):
            res_name = res.get('name', '')
            if res_name and not res.get('frontend', False) and _is_registered_resource(res) and res_name not in names:
                names.append(res_name)
    return names


def _build_all_services_map(all_services):
    """Map each service group (stack) name and each resource name to its service group."""
    all_services_map = {}
    for svc in all_services:
        svc_name = svc.get('name', '')
        if svc_name:
            all_services_map[svc_name] = svc
        for res in svc.get('resources', []):
            res_name = res.get('name', '')
            if res_name:
                all_services_map[res_name] = svc
    return all_services_map


def _fail_on_dependency_cycle(all_services_map):
    """Stop the Tiltfile with a clear message when the services wait for each other in a circle.

    Tilt checks the resource graph itself, but when it rejects a cycle it stops watching the service.json files, so fixing the
    file does nothing and the stack stays on the old graph until it is restarted. An ordinary Starlark error keeps every watch,
    so the Tiltfile reloads on its own once the cycle is gone. The edges are the ones `_build_resource_deps` gives resource_deps.
    """
    edges = {}
    for svc in all_services_map.values():
        for res in svc.get('resources', []):
            name = res.get('name', '')
            if not name or name in edges or not _is_registered_resource(res):
                continue
            manifest = res.get('_manifest', {}) or {}
            waits = []
            for dep in declared_dependencies(manifest):
                for target in _resolve_dependency_to_resources(dep, all_services_map):
                    if target != 'postgres' and target != name and target not in waits:
                        waits.append(target)
            if res.get('frontend', False):
                backend_name = manifest.get('backendName', name.replace('frontend', 'backend'))
                if backend_name != name and _is_known_resource(backend_name, all_services_map) and backend_name not in waits:
                    waits.append(backend_name)
            edges[name] = waits
    cycle = find_dependency_cycle(edges)
    if cycle:
        fail("""
❌ ═══════════════════════════════════════════════════════════════════
❌  CIRCULAR dependsOn
❌ ═══════════════════════════════════════════════════════════════════
   {cycle}

   These services wait for each other, so none of them can start.
   Remove one "dependsOn" entry (or "backendName") in their service.json files.
   This Tiltfile reloads by itself once the circle is gone.
❌ ═══════════════════════════════════════════════════════════════════
""".format(cycle=' -> '.join(cycle)))


def resolve_dependency_to_resources(dep_name, all_services_map):
    """Public wrapper over `_resolve_dependency_to_resources` (exported for tests)."""
    return _resolve_dependency_to_resources(dep_name, all_services_map)


def resolve_dependency_to_resource(dep_name, all_services_map):
    """Public wrapper over `_resolve_dependency_to_resource` (exported for tests)."""
    return _resolve_dependency_to_resource(dep_name, all_services_map)


def build_infra_dependencies(resource_name, should_enable, ctx=None, has_backend=False, uses_golden_image=True):
    """Public wrapper over `_build_infra_dependencies` (exported for tests).

    feature off → no postgres; feature on → has postgres (plus backend
    provision-db edge when has_backend is true). The golden build is a dependency only
    when uses_golden_image is true.
    """
    return _build_infra_dependencies(resource_name, should_enable, ctx if ctx != None else {}, has_backend, uses_golden_image)


def stack_uses_golden_image(resource_config, resource_manifests):
    """Public wrapper over `_stack_uses_golden_image` (exported for tests)."""
    return _stack_uses_golden_image(resource_config, resource_manifests)


def stack_waits_for_golden_step(resource_config, resource_manifests, all_services_map):
    """Public wrapper over `_stack_waits_for_golden_step` (exported for tests)."""
    return _stack_waits_for_golden_step(resource_config, resource_manifests, all_services_map)


def build_resource_deps(res, res_name, manifest, resource_config, infra_deps, config_gen_resources=None, resource_manifests=None, runtime_flags=None, all_services_map=None):
    """Public wrapper over `_build_resource_deps` (exported for tests).

    Ensures the dependsOn→resource_deps edge is exercised by tests: feature off
    + dependsOn postgres → postgres edge present; feature on + dependsOn →
    exactly one postgres edge (infra_deps already carries it).
    """
    default_runtime_flags = {
        'enforce_migrator_deps': False,
        'auto_init_apps': True,
        'disable_app_replicas': False,
    }
    return _build_resource_deps(
        res, res_name, manifest, resource_config, infra_deps,
        config_gen_resources if config_gen_resources != None else {},
        resource_manifests if resource_manifests != None else {},
        runtime_flags if runtime_flags != None else default_runtime_flags,
        all_services_map,
    )


def _build_resource_deps(res, res_name, manifest, resource_config, infra_deps, config_gen_resources, resource_manifests, runtime_flags, all_services_map=None):
    # Drop self-deps: shared infra_deps always includes verdaccio when enabled, so
    # registering verdaccio itself would otherwise produce resource_deps=['verdaccio'].
    res_deps = [dep for dep in infra_deps if dep != res_name]
    if res_name in config_gen_resources:
        res_deps.append(config_gen_resources[res_name])
    if res.get('frontend', False):
        backend_name = manifest.get('backendName', res_name.replace('frontend', 'backend'))
        # The backend may live in another stack, so look it up among all services, not only this stack's resources.
        if backend_name != res_name and (backend_name in resource_manifests or _is_known_resource(backend_name, all_services_map)):
            res_deps.append(backend_name)
    elif runtime_flags['enforce_migrator_deps'] and resource_config.get('has_migrator', False):
        migrator_name = resource_config['name'] + '-db-migrator'
        if migrator_name not in res_deps:
            res_deps.append(migrator_name)
    
    # Resolve dependsOn from the manifest: services, stacks (their backend-side services) and the shared Postgres.
    conditions = dict(manifest.get('dependsOnConditions', {})) if manifest and type(manifest.get('dependsOnConditions')) == 'dict' else {}
    if manifest and type(manifest.get('dependsOn')) == 'list':
        for entry in manifest['dependsOn']:
            if type(entry) == 'dict':
                entry_name = entry.get('name')
                entry_cond = entry.get('condition')
                if entry_name and entry_cond and entry_name not in conditions:
                    conditions[entry_name] = entry_cond

    for dep in declared_dependencies(manifest):
        resolved = _resolve_dependency_to_resources(dep, all_services_map)
        if not resolved and not _is_unregistered_resource(dep, all_services_map):
            # Not a service or stack: keep the name Tilt has always been given (a `-yaml` echo resource, or nothing).
            resolved = [_resolve_dependency_to_resource(dep, all_services_map or {})]
        
        is_direct = _is_known_resource(dep, all_services_map) or is_shared_platform_postgres_dependency(dep) or _is_database_resource(dep, all_services_map)
        is_expanded_stack = (not is_direct) or (len(resolved) > 1)
        dep_condition = conditions.get(dep, None)

        for resolved_dep in resolved:
            if resolved_dep and resolved_dep != res_name and resolved_dep not in res_deps:
                res_deps.append(resolved_dep)
            
            # Check if resolved_dep is a valid runnable resource (or not an unregistered echo name)
            is_valid_res = resolved_dep and resolved_dep != res_name and (not resolved_dep.endswith("-yaml") or _is_known_resource(resolved_dep, all_services_map))

            if is_valid_res:
                dep_is_job = _is_job_resource(resolved_dep, all_services_map)

                if is_expanded_stack:
                    # Expanded stack dependency (e.g. {"name": "shop", "condition": "service_healthy"}).
                    # Route each member service to its valid companion gate:
                    # - service_healthy: persistent services with health checks wait for <svc>-healthy; one-shot migrators wait for <job>-done.
                    # - service_completed_successfully: migrators wait for <job>-done; persistent services wait for <svc>-healthy.
                    # - service_started: all members only wait for container start (no companion gates).
                    # - unconditioned (default): persistent services wait for start; migrators default to <job>-done (#2871).
                    if dep_condition == "service_healthy":
                        if dep_is_job:
                            companion = job_done_resource_name(resolved_dep)
                            if companion not in res_deps:
                                res_deps.append(companion)
                        elif _service_has_health_check(resolved_dep, all_services_map):
                            companion = job_healthy_resource_name(resolved_dep)
                            if companion not in res_deps:
                                res_deps.append(companion)
                    elif dep_condition == "service_completed_successfully":
                        companion = job_done_resource_name(resolved_dep) if dep_is_job else job_healthy_resource_name(resolved_dep)
                        if companion not in res_deps:
                            res_deps.append(companion)
                    elif dep_condition == "service_started":
                        pass
                    elif dep_is_job:
                        done = job_done_resource_name(resolved_dep)
                        if done not in res_deps:
                            res_deps.append(done)
                else:
                    # Directly named service or one-shot job dependency. Enforce strict condition validity.
                    if dep_condition == "service_healthy":
                        if dep_is_job:
                            fail("MANIFEST ERROR: dependency '{}' of '{}' specifies condition 'service_healthy', but '{}' is a one-shot job that exits on completion without a health check. Use 'service_completed_successfully' or 'service_started'.".format(resolved_dep, res_name, resolved_dep))
                        if not _service_has_health_check(resolved_dep, all_services_map):
                            fail("MANIFEST ERROR: dependency '{}' of '{}' specifies condition 'service_healthy', but '{}' has no health check configured (or healthCheck is disabled). Configure healthCheck (path, port, or command) or use 'service_started'.".format(resolved_dep, res_name, resolved_dep))
                        healthy = job_healthy_resource_name(resolved_dep)
                        if healthy not in res_deps:
                            res_deps.append(healthy)

                    elif dep_condition == "service_completed_successfully":
                        if not dep_is_job:
                            fail("MANIFEST ERROR: dependency '{}' of '{}' specifies condition 'service_completed_successfully', but '{}' is a long-running service that does not exit on completion. Use 'service_healthy' or 'service_started'.".format(resolved_dep, res_name, resolved_dep))
                        done = job_done_resource_name(resolved_dep)
                        if done not in res_deps:
                            res_deps.append(done)

                    elif dep_condition == "service_started":
                        pass

                    elif dep_is_job:
                        # Direct dependency on a one-shot job with no explicit condition: default to completion (#2871)
                        done = job_done_resource_name(resolved_dep)
                        if done not in res_deps:
                            res_deps.append(done)
    
    return res_deps


def job_healthy_resource_name(svc):
    """The Tilt resource that waits for a service to become healthy (see _register_healthy_resource)."""
    return svc + '-healthy'


def job_done_resource_name(job):
    """The Tilt resource that waits for a one-shot job to exit (see _register_job_done_resource)."""
    return job + '-done'


def _is_job_resource(name, all_services_map):
    """True when `name` is a registered one-shot job (a migrator, or bring-your-own with "restart": "no")."""
    service = (all_services_map or {}).get(name)
    if not service:
        return False
    for res in service.get('resources', []):
        if res.get('name', '') == name:
            return _is_registered_resource(res) and is_one_shot_job(res.get('_manifest', {}) or {})
    return False


def _find_resource_manifest(name, all_services_map):
    """Locate the manifest for a resource by name across all_services_map."""
    service = (all_services_map or {}).get(name)
    if service:
        for res in service.get('resources', []):
            if res.get('name', '') == name:
                return res.get('_manifest', {}) or {}
    for svc in (all_services_map or {}).values():
        if type(svc) == 'dict':
            for res in svc.get('resources', []):
                if res.get('name', '') == name:
                    return res.get('_manifest', {}) or {}
    return None


def _service_has_health_check(name, all_services_map):
    """True when `name` has an active health check configured (path, port, command, or postgres default)."""
    if is_shared_platform_postgres_dependency(name) or _is_database_resource(name, all_services_map):
        return True
    manifest = _find_resource_manifest(name, all_services_map)
    if manifest == None:
        # Unknown/external resource: assume true to avoid false negative when manifest is omitted
        return True
    hc = manifest.get('healthCheck')
    if hc == False or (type(hc) == 'dict' and hc.get('enabled') == False):
        return False
    if type(hc) == 'dict' and (hc.get('path') or hc.get('port') or hc.get('command')):
        return True
    if manifest.get('healthCheckPath'):
        return True
    app_type = manifest.get('appType')
    if app_type == 'bring-your-own':
        return False
    if app_type == 'migrator':
        return False
    return True


def resource_defers_start(manifest):
    """True when a manifest opts into `sablier.enable` + `sablier.deferStart`
    AND the licensed sablier module is actually active.

    deferStart stays behind the same FLISK_LICENSE_KEY gate as the rest of
    `sablier` (an explicit product decision, not just the opt-in manifest
    flag): the free-tier stub's sablier_middleware_suffix() always reports
    `enabled=False` regardless of what the manifest says, so checking through
    it here -- rather than reading manifest['sablier']['enable'] directly --
    is what keeps deferStart off for unlicensed projects. Without this check,
    a project with no license would still get "no container created or
    started," silently bypassing the license boundary for the disable-the-
    container half of the feature even though the Docker-label wake half
    stays correctly disabled.

    A deferred resource's image still builds (docker_build has no auto_init
    gate), but its dc_resource/run-only/replica resources are held back with
    auto_init=False: no container is created or started until the Traefik
    static route wakes it on first request (see openspec/changes/
    prioritized-cold-start)."""
    _, sablier_licensed_and_enabled = sablier_middleware_suffix(manifest, '')
    sablier = manifest.get('sablier', {}) if manifest else {}
    defers_start = bool(sablier.get('enable', False) and sablier.get('deferStart', False))
    if defers_start and not sablier_licensed_and_enabled:
        print("⚠️  '{}' requests sablier.deferStart but the licensed Sablier overlay is disabled; starting normally".format(manifest.get('name', 'resource')))
    if not sablier_licensed_and_enabled:
        return False
    return defers_start


def resolve_manifest_dependency_names(manifest, all_services_map):
    """Resolve a manifest's `dependsOn` short names to full resource names,
    reusing the same `_resolve_dependency_to_resource` that `_build_resource_deps`
    already trusts for Tilt's own resource_deps ordering -- an ambiguous name
    behaves identically here as it already does there."""
    resolved = []
    for dep in declared_dependencies(manifest):
        names = _resolve_dependency_to_resources(dep, all_services_map)
        if not names and not _is_unregistered_resource(dep, all_services_map):
            names = [_resolve_dependency_to_resource(dep, all_services_map or {})]
        for resolved_dep in names:
            if resolved_dep and resolved_dep not in resolved:
                resolved.append(resolved_dep)
    return resolved


def resolve_defer_start_dependencies(manifest, resource_manifests, all_services_map):
    """Of a deferStart resource's manifest dependencies, resolve the subset
    that are themselves deferStart resources, for the wake gateway's
    X-Wake-Deps (see generate_static_wake_route's `dependencies` param and
    openspec/changes/prioritized-cold-start design.md D5).

    A dependsOn name `_resolve_dependency_to_resource` can't map to an exact
    resource (its own fallback branches -- see that function) won't be a key
    in `resource_manifests` either, so it's quietly excluded here rather than
    guessed at -- consistent with D5's existing stance. Always-on infra
    (database, NATS) is never itself a deferStart resource (D5), so in
    practice this only ever picks up the one case D5 flags as mattering: a
    deferStart resource depending on another."""
    dependencies = []
    for resolved_dep in resolve_manifest_dependency_names(manifest, all_services_map):
        dep_manifest = resource_manifests.get(resolved_dep)
        if not dep_manifest or not resource_defers_start(dep_manifest):
            continue
        dep_service_name = all_services_map.get(resolved_dep, {}).get('name', '')
        if not dep_service_name:
            continue
        dependencies.append((resolved_dep, PlatformDockerConstants.compose_project_name(dep_service_name)))
    return dependencies


def _register_replicas(config, auto_init_apps):
    """Register additional replica resources for high-availability services."""
    replicas = config.get('replicas', 1)
    if replicas <= 1:
        return
    # Docker compose generates replicas starting from 1 (e.g., service-1, service-2)
    # Primary is the base name (service), replicas are service-1, service-2, etc.
    for i in range(1, replicas):
        replica_name = config['res_name'] + '-' + str(i)
        dc_resource(
            replica_name,
            labels=config['labels'],
            resource_deps=config['res_deps'],
            auto_init=auto_init_apps,
        )


def _live_update_sync_source(project_root, full_res_path, sync_path):
    """Local path Tilt watches for a live-update sync.

    Tilt resolves sync() local paths against the Tiltfile directory (.flisk/.flisk-out), not
    the docker_build context, so a project-relative path never matches the changed files
    and every edit falls back to a full image rebuild ("Found file(s) not matching any
    sync"). Anchor it at the project root, like the Dockerfile and build context.
    """
    relative_path = full_res_path + '/' + sync_path
    if project_root:
        return project_root.rstrip('/') + '/' + relative_path
    return relative_path


def _bun_backend_entry(config):
    """`index` when this Bun service runs a compiled `dist/index.js` built from `src/index.ts`, otherwise None.

    The image holds only `dist/`, so a synced source changes nothing until `dist/` is rebuilt and the process restarted.
    """
    manifest = config.get('manifest', {})
    if manifest.get('language', 'bun') != 'bun' or is_one_shot_job(manifest):
        return None
    if manifest.get('appType', 'backend') not in ['backend', 'worker', 'mcp', 'agent']:
        return None
    for token in resolve_bun_start_command(config['res_path']).split():
        if token.startswith('dist/') and token.endswith('.js'):
            entry = token[len('dist/'):-len('.js')]
            project_root = config.get('project_root', '')
            service_dir = (project_root.rstrip('/') + '/' if project_root else '') + config['res_path']
            return entry if os.path.exists(service_dir + '/src/' + entry + '.ts') else None
    return None


# Files whose change only a fresh install fixes, for every language with live update (Go lists its own).
_DEPENDENCY_FILES = ['package.json', 'bun.lock', 'bun.lockb', 'package-lock.json', 'pyproject.toml', 'uv.lock', 'requirements.txt']


def _build_live_update_rules(res_path, full_res_path, syncs, project_root='', language='bun', go_live_reload=False, node_frontend=False, bun_backend_entry=None):
    """Build live update sync and run rules for a resource.

    Python backends reload their own process after a sync (uvicorn --reload), so they have
    no Bun install step. A changed dependency file (package.json, a lockfile, pyproject.toml) rebuilds the image.
    Rust backends, and Go backends without `dev.liveReload`, have no live update (see the early return).
    """
    # Go and Rust are compiled into the image and have no reload process, so syncing sources would leave the
    # old binary running. Return before any sync() step is built (Tilt rejects sync steps that are created
    # but never used): no live-update rules means Tilt rebuilds the image when a watched file changes.
    if language == 'rust' or (language == 'go' and not go_live_reload):
        return []

    if go_live_reload:
        # Opted-in Go development loop: sync the sources into the development image, where the flisk-go-watch script rebuilds and restarts.
        # Dependency and Dockerfile changes cannot be picked up by a restart, so they fall back to a full image rebuild.
        source_dir = _live_update_sync_source(project_root, full_res_path, '')
        return [
            fall_back_on([
                source_dir + 'go.mod',
                source_dir + 'go.sum',
                source_dir + OUTPUT.AUTOGENERATED_FOLDER,
            ]),
            sync(source_dir.rstrip('/'), '/app/' + full_res_path),
        ]

    # A dependency change needs the image's install layer, which a sync cannot run: rebuild the image. Tilt matches these
    # against local paths, so they are anchored at the project root like the syncs (a container path never matches).
    source_dir = _live_update_sync_source(project_root, full_res_path, '')
    live_update_rules = [fall_back_on([source_dir + name for name in _DEPENDENCY_FILES])]
    for sync_path in syncs:
        # Python and Node images never read the Bun registry config, and the engine does not
        # generate it for provider-owned languages, so there is nothing to sync.
        if language == 'python' and (
            sync_path.endswith('.npmrc.docker.autogenerated') or sync_path.endswith('bunfig.docker.autogenerated.toml')
        ):
            continue
        if language == 'node' and (
            sync_path.endswith('.npmrc.docker.autogenerated') or sync_path.endswith('bunfig.docker.autogenerated.toml')
        ):
            continue
        full_sync_path = _live_update_sync_source(project_root, full_res_path, sync_path)
        dest = '/app/' + full_res_path + '/' + sync_path
        live_update_rules.append(sync(full_sync_path, dest))
    
    if language == 'python' or language == 'node' or node_frontend:
        return live_update_rules
    
    if bun_backend_entry:
        # `bun build`, not the image's `tsc`: the runtime image has no dev dependencies. Packages stay external, as `tsc` leaves them.
        # A compile error writes nothing and stops before the restart, so the last good build keeps running.
        live_update_rules.append(run(
            'cd /app/' + full_res_path + ' && bun build ./src/' + bun_backend_entry + '.ts --outdir dist --target bun --packages external',
            trigger=[_live_update_sync_source(project_root, full_res_path, 'src')],
        ))
        live_update_rules.append(restart_container())
    return live_update_rules


def _app_image_name(resource_name, res_name):
    """The image ref docker_build builds and the app compose service declares (project-scoped; see constants.star)."""
    return PlatformDockerConstants.app_image_name(resource_name, res_name)


def _wake_compose_invocation(project_root, resource_path, res_name, resource_name):
    """Compose files, env file and image for the wake gateway's direct start.

    The same files/--env-file the `-run-only` resource passes, as absolute
    normalized paths: the gateway mounts the project at the same normalized
    root (traefik_standalone.star), so these resolve identically there.
    Returns None without a project root (paths would be relative to Tilt's cwd).
    """
    if not project_root:
        return None
    root = normalize_abs_path(project_root)
    compose_dir = root + '/' + resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER
    files = [compose_dir + '/docker-compose.app.autogenerated.yml']
    port_override = compose_dir + '/docker-compose.port-override.yml'
    if os.path.exists(port_override):
        files.append(port_override)
    # The gateway mounts the project at its normalized absolute path, so the env file has to be
    # named the same way: project_env_file(root) is the project .env by default and the file
    # `flisk up --env-file` selected (an absolute path inside the project) otherwise.
    env_file = project_env_file(root)
    return {
        'compose_files': files,
        'env_file': env_file if os.path.exists(env_file) else '',
        'image': _app_image_name(resource_name, res_name),
    }


def _uses_generated_dockerfile(config):
    """True when Tilt builds the Dockerfile Flisk generates, not one the user wrote (`dockerfile` outside `.autogenerated`)."""
    rel_dockerfile = config.get('dockerfile', '')
    return not rel_dockerfile or OUTPUT.AUTOGENERATED_FOLDER in rel_dockerfile.split('/')


def _image_target(config):
    """The Dockerfile target Tilt builds and the deferStart prebuild must match: `development` wherever a stage reloads on a sync."""
    manifest = config.get('manifest', {})
    # Next.js runs `next dev` in the development image, so a saved file hot-reloads through the synced sources.
    if Docker.is_next_frontend(manifest):
        return 'development'
    # A Bun backend's generated development stage runs its watching `dev` script over the synced sources; production would run the
    # stale dist (#3395). A Dockerfile the user wrote may have no such stage (or only `production`), so it keeps building `production`.
    if _uses_generated_dockerfile(config) and Docker.bun_live_reload(manifest, config['res_path']):
        return 'development'
    return 'development' if Docker.go_live_reload(manifest) else 'production'


# The target choice, exposed for the engine tests (a leading-underscore name cannot be loaded).
image_target = _image_target


def _register_docker_build(config, live_update_rules):
    """Register docker_build with live_update for hot-reload support."""
    TypescriptBuilders.build_typescript_service(
        _app_image_name(config['resource_name'], config['res_name']),
        config.get('project_root', '') or '.',
        _resolve_dockerfile(config),
        live_update_rules,
        config['res_deps'],
        target = _image_target(config),
    )


def _register_deferred_image_prebuild(config, auto_init_apps):
    """Build a deferStart resource's image during `flisk up` without creating its container.

    `auto_init=False` on the dc_resource skips its docker_build too (confirmed
    live on flisk-erp-system, task 7.2), so a fresh project's first request would
    find no image and the wake gateway would fall back to `tilt trigger`, which
    queues behind every other build. This local_resource builds the same image
    (same Dockerfile and target as docker_build: `production`, or `development` for Go with `dev.liveReload` and Bun with a watching `dev` script; host network, and an allowlist
    .dockerignore equivalent to docker_build's only=/ignore=) under the tag the
    compose service declares, so the gateway can start it directly.
    """
    project_root = config.get('project_root', '')
    dockerfile = _resolve_dockerfile(config)
    prebuild_dockerfile = dockerfile + '.prebuild'
    # The same target _register_docker_build picks: a service that reloads (Go with `dev.liveReload`, Bun with a watching `dev` script) runs
    # the development image, so prebuilding `production` under the same tag would start the compiled build with no reload.
    target = _image_target(config)
    ignore_content = TypescriptBuilders.prebuild_dockerignore(dockerfile, project_root, config['res_path'])
    # BuildKit reads `<dockerfile>.dockerignore` for `-f <dockerfile>`; the
    # original Dockerfile already has a (denylist) one, hence the copy.
    cmd = [
        "sh", "-c",
        'cp "$1" "$2" && printf "%s" "$3" > "$2.dockerignore"' +
        ' && docker build --network host --target "$4" -f "$2" -t "$5" "$6"',
        "sh",
        dockerfile,
        prebuild_dockerfile,
        ignore_content,
        target,
        _app_image_name(config['resource_name'], config['res_name']),
        project_root or '.',
    ]
    local_resource(
        name=config['res_name'] + '-image',
        cmd=cmd,
        cmd_bat=POWERSHELL + [prebuild_image_script()],
        env={
            'FLISK_DOCKERFILE': dockerfile,
            'FLISK_PREBUILD': prebuild_dockerfile,
            'FLISK_IGNORE': ignore_content,
            'FLISK_TARGET': target,
            'FLISK_TAG': _app_image_name(config['resource_name'], config['res_name']),
            'FLISK_BUILD_CONTEXT': project_root or '.',
        },
        labels=config['labels'],
        resource_deps=config['res_deps'],
        auto_init=auto_init_apps,
    )


def _resolve_dockerfile(config):
    """Absolute (when project_root is set) path of a resource's Dockerfile."""
    project_root = config.get('project_root', '')
    # Use custom dockerfile from config if specified, otherwise use autogenerated default
    # The res_path is relative to project_root (e.g., 'services/product/...')
    # The dockerfile config is relative to res_path (e.g., '.autogenerated/Dockerfile...')
    rel_dockerfile = config.get('dockerfile', '')
    if rel_dockerfile:
        if rel_dockerfile.startswith('/'):
            dockerfile = config['res_path'] + rel_dockerfile
        else:
            dockerfile = config['res_path'] + '/' + rel_dockerfile
    else:
        dockerfile = config['res_path'] + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/Dockerfile.app.autogenerated'
    # Prepend project_root to make absolute path from the Tilt working directory
    if project_root:
        if dockerfile.startswith('/'):
            dockerfile = project_root + dockerfile
        else:
            dockerfile = project_root + '/' + dockerfile
    return dockerfile


def register_python_test_resource(config, resource_path, compose_project_name, auto_init_apps=True):
    """Register an independent Tilt test resource for Python pytest-on-save.

    Runs pytest inside the service container via docker compose exec when source or test files change.
    A test failure is reported in Tilt without crashing or restarting the healthy application container.
    """
    manifest = config.get('manifest', {})
    if not Docker.python_test_on_save(manifest):
        return

    res_name = config['res_name']
    test_path = Docker.python_test_path(manifest)
    project_root = config.get('project_root', '')
    service_dir = (project_root.rstrip('/') + '/' if project_root else '') + config['res_path']

    compose_dir = resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER
    compose_file = compose_dir + '/docker-compose.app.autogenerated.yml'
    port_override = compose_dir + '/docker-compose.port-override.yml'
    env_file = '.env'
    if project_root:
        root = project_root.rstrip('/')
        compose_file = root + '/' + compose_file
        port_override = root + '/' + port_override
        env_file = project_env_file(root)

    compose_files = ['-f', compose_file]
    if file_exists(port_override):
        compose_files = compose_files + ['-f', port_override]

    test_dir = service_dir + '/' + test_path if test_path != '.' else service_dir
    deps = [service_dir + '/src', service_dir + '/pyproject.toml']
    if os.path.exists(test_dir):
        deps.append(test_dir)

    all_services = config.get('all_services', {})
    test_res_name = res_name + '-test'
    if test_res_name in all_services:
        test_res_name = res_name + '-pytest'

    cmd = [
        "sh", "-c",
        'RUNNING_ID=$(docker compose -p "$1" -f "$2" ps --status running -q "$3" 2>/dev/null); ' +
        'if [ -z "$RUNNING_ID" ]; then ' +
        '  echo "[flisk] Container $3 is not currently running; skipping pytest" && exit 0; ' +
        'fi; ' +
        'if [ "$4" != "." ] && [ -n "$5" ] && [ ! -e "$5" ]; then ' +
        '  echo "[flisk] Test path \'"$4"\' does not exist; skipping pytest" && exit 0; ' +
        'fi; ' +
        'if [ "$4" != "." ] && [ -n "$5" ] && [ -d "$5" ]; then ' +
        '  docker compose -p "$1" -f "$2" cp "$5/." "$3:/app/$6/$4" 2>/dev/null || docker cp "$5/." "$RUNNING_ID:/app/$6/$4" 2>/dev/null || true; ' +
        'fi; ' +
        'docker compose -p "$1" -f "$2" exec -T "$3" sh -c ' +
        '\'if ! command -v pytest >/dev/null 2>&1; then ' +
        '  echo "[flisk] Error: pytest is not installed in container $1."; ' +
        '  echo "[flisk] Hint: Add pytest to pyproject.toml dev dependencies (e.g. pip install -e \\".[dev]\\")"; ' +
        '  exit 1; ' +
        'fi; ' +
        'exec pytest "$2"\' ' +
        'sh "$3" "$4"',
        "sh",
        compose_project_name,
        compose_file,
        res_name,
        test_path,
        test_dir if test_path != '.' else '',
        config['res_path'],
    ]

    local_resource(
        name=test_res_name,
        cmd=cmd,
        cmd_bat=POWERSHELL + [pytest_script()],
        env={
            'FLISK_PROJECT': compose_project_name,
            'FLISK_COMPOSE_FILE': compose_file,
            'FLISK_SERVICE': res_name,
            'FLISK_TEST_PATH': test_path,
            'FLISK_TEST_DIR': test_dir if test_path != '.' else '',
            'FLISK_RES_PATH': config['res_path'],
        },
        deps=deps,
        ignore=[
            '**/__pycache__/**',
            '**/*.pyc',
            '**/.pytest_cache/**',
            '**/.coverage',
            '**/.mypy_cache/**',
            '**/.git/**',
        ],
        labels=config['labels'] + ['test'],
        resource_deps=[config['res_name']],
        auto_init=auto_init_apps,
        allow_parallel=False,
    )


def _compose_project_argv(config, resource_path, compose_project_name):
    """`docker compose -p <project> -f <files> [--env-file <file>]` for this stack, as an argv list."""
    project_root = config.get('project_root', '')
    compose_dir = resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER
    compose_file = compose_dir + '/docker-compose.app.autogenerated.yml'
    port_override = compose_dir + '/docker-compose.port-override.yml'
    env_file = '.env'
    if project_root:
        root = project_root.rstrip('/')
        compose_file = root + '/' + compose_file
        port_override = root + '/' + port_override
        env_file = project_env_file(root)
    compose_files = ['-f', compose_file]
    if file_exists(port_override):
        compose_files = compose_files + ['-f', port_override]
    # .env is gitignored (no .env.example shipped) across every Flisk example repo, so a
    # fresh clone must not hard-require it: only pass --env-file when it actually exists.
    env_file_flag = []
    if file_exists(env_file):
        env_file_flag = ['--env-file', env_file]
    # Built as an argv list (extend, not `+`) so no argument is ever joined into shell text.
    argv = ['docker', 'compose', '-p', compose_project_name]
    argv.extend(compose_files)
    argv.extend(env_file_flag)
    return argv


def _register_run_only_resource(config, resource_path, compose_project_name, auto_init_apps=True):
    """Register a run-only local resource for docker compose up."""
    run_only_argv = _compose_project_argv(config, resource_path, compose_project_name)
    run_only_argv.extend(['up', '-d', '--no-build', config['res_name']])
    local_resource(
        name=config['res_name'] + '-run-only',
        cmd=run_only_argv,
        labels=config['labels'] + ['run-only'],
        # The run-only Compose command uses the image produced by the main
        # resource. Keep it behind that resource so --no-build cannot race
        # the ImageBuild and fail with a missing image.
        resource_deps=config['res_deps'] + [config['res_name']],
        auto_init=auto_init_apps,
        allow_parallel=True,
    )


def _register_single_resource(config, resource_path, compose_project_name, auto_init_apps):
    """Register a single dc_resource with optional docker_build and run-only resource."""
    app_type = config.get('app_type', 'backend')
    res_name = config['res_name']

    # A sablier.enable + sablier.deferStart resource is held back from flisk up's
    # normal bring-up: its container is never created or started here, only via
    # the Traefik wake path on first request. auto_init=False also skips the
    # dc_resource's docker_build, so its image is built by a separate
    # `<name>-image` resource instead (_register_deferred_image_prebuild).
    defers_start = resource_defers_start(config.get('manifest', {}))
    effective_auto_init = auto_init_apps and not defers_start

    debug_log("REGISTER: Registering '{}' app_type='{}' auto_init={}".format(res_name, app_type, effective_auto_init))

    # Skip docker_build for libraries and SDKs - they don't have Dockerfiles
    if app_type not in ['library', 'sdk', 'bring-your-own'] and config.get('syncs'):
        debug_log("REGISTER: '{}' has syncs, calling docker_build".format(res_name))
        syncs = list(config['syncs'])
        if Docker.python_test_on_save(config.get('manifest', {})):
            test_path = Docker.python_test_path(config.get('manifest', {}))
            if test_path and test_path != '.' and test_path not in syncs:
                project_root = config.get('project_root', '')
                service_dir = (project_root.rstrip('/') + '/' if project_root else '') + config['res_path']
                test_dir = service_dir + '/' + test_path
                if os.path.exists(test_dir):
                    syncs.append(test_path)
        live_update_rules = _build_live_update_rules(
            config['res_path'],
            config['res_path'],
            syncs,
            project_root=config.get('project_root', ''),
            language=config.get('manifest', {}).get('language', 'bun'),
            # A Next.js image is Node with no Bun install step: syncing sources is enough, `next dev` reloads itself.
            node_frontend=Docker.is_next_frontend(config.get('manifest', {})),
            go_live_reload=Docker.go_live_reload(config.get('manifest', {})),
            bun_backend_entry=_bun_backend_entry(config),
        )
        _register_docker_build(config, live_update_rules)
        if defers_start:
            _register_deferred_image_prebuild(config, auto_init_apps)
    else:
        debug_log("REGISTER: '{}' skipping docker_build (app_type='{}', syncs={})".format(res_name, app_type, config.get('syncs')))

    debug_log("REGISTER: Calling dc_resource for '{}' with deps={}".format(res_name, config['res_deps']))
    dc_resource(
        config['res_name'],
        labels=config['labels'],
        resource_deps=config['res_deps'],
        auto_init=effective_auto_init,
    )
    debug_log("REGISTER: dc_resource completed for '{}'".format(res_name))

    _register_run_only_resource(config, resource_path, compose_project_name, effective_auto_init)
    if is_one_shot_job(config.get('manifest', {})):
        _register_job_done_resource(config, resource_path, compose_project_name, effective_auto_init)
    else:
        _register_healthy_resource(config, resource_path, compose_project_name, effective_auto_init)
    _register_replicas(config, effective_auto_init)
    register_python_test_resource(config, resource_path, compose_project_name, effective_auto_init)


_HEALTHY_SCRIPT = (
    'job="$1"; max_polls="${2:-120}"; shift 2 2>/dev/null || shift 1; exited_count=0; '
    + 'grace=120; bad_since=""; i=0; '
    + 'while [ "$i" -lt "$max_polls" ] || { [ -n "$bad_since" ] && [ $((i - bad_since)) -lt "$grace" ]; }; do '
    + '  i=$((i + 1)); '
    + '  if [ "$#" -gt 0 ]; then '
    + '    id="$("$@" ps -q "$job" 2>/dev/null | head -n 1)"; '
    + '    if [ -z "$id" ]; then id="$("$@" ps -a -q "$job" 2>/dev/null | head -n 1)"; fi; '
    + '  else '
    + '    id="$(docker ps -q -f "name=^/${job}$" 2>/dev/null | head -n 1)"; '
    + '    if [ -z "$id" ]; then id="$(docker ps -a -q -f "name=^/${job}$" 2>/dev/null | head -n 1)"; fi; '
    + '  fi; '
    + '  if [ -z "$id" ]; then sleep 1; continue; fi; '
    + '  state="$(docker inspect --format="{{.State.Status}}" "$id" 2>/dev/null)"; '
    + '  if [ "$state" = "dead" ]; then '
    + '    code="$(docker inspect --format="{{.State.ExitCode}}" "$id" 2>/dev/null)"; '
    + '    echo "ERROR: container $job is dead (exit code $code)"; exit 1; '
    + '  fi; '
    + '  if [ "$state" = "exited" ]; then '
    + '    policy="$(docker inspect --format="{{.HostConfig.RestartPolicy.Name}}" "$id" 2>/dev/null)"; '
    + '    code="$(docker inspect --format="{{.State.ExitCode}}" "$id" 2>/dev/null)"; '
    + '    if [ "$policy" = "no" ] || [ -z "$policy" ]; then '
    + '      exited_count=$((exited_count + 1)); '
    + '      if [ "$exited_count" -ge 5 ]; then '
    + '        echo "ERROR: container $job exited with code $code and will not restart (restart: ${policy:-no})"; exit 1; '
    + '      fi; '
    + '    else '
    + '      exited_count=0; '
    + '    fi; '
    + '  else '
    + '    exited_count=0; '
    + '  fi; '
    + '  has_health="$(docker inspect --format="{{if .State.Health}}yes{{else}}no{{end}}" "$id" 2>/dev/null)"; '
    + '  if [ "$has_health" = "no" ]; then '
    + '    if [ "$state" = "running" ]; then '
    + '      echo "$job has no health check configured, proceeding once running"; exit 0; '
    + '    fi; '
    + '  else '
    + '    health="$(docker inspect --format="{{.State.Health.Status}}" "$id" 2>/dev/null)"; '
    + '    if [ "$health" = "healthy" ]; then echo "$job is healthy"; exit 0; fi; '
    + '    if [ "$health" = "unhealthy" ]; then '
    + '      codes="$(docker inspect --format="{{range .State.Health.Log}}{{.ExitCode}} {{end}}" "$id" 2>/dev/null)"; '
    + '      outs="$(docker inspect --format="{{range .State.Health.Log}}{{.Output}}{{end}}" "$id" 2>/dev/null)"; '
    + '      streak="$(docker inspect --format="{{.State.Health.FailingStreak}}" "$id" 2>/dev/null)"; '
    + '      total=0; runs=0; n126=0; n127=0; neg=0; '
    + '      for c in $codes; do '
    + '        total=$((total + 1)); '
    + '        if [ "$c" = "-1" ]; then neg=$((neg + 1)); '
    + '        elif [ "$c" = "126" ]; then n126=$((n126 + 1)); '
    + '        elif [ "$c" = "127" ]; then n127=$((n127 + 1)); '
    + '        else runs=1; fi; '
    + '      done; '
    + '      e_neg="$(echo "$outs" | grep -o "OCI runtime exec failed" | wc -l | tr -d " ")"; '
    + '      e127="$(echo "$outs" | grep -o "not found" | wc -l | tr -d " ")"; '
    + '      e126="$(echo "$outs" | grep -oiE "permission denied|cannot execute|not executable|is a directory" | wc -l | tr -d " ")"; '
    + '      if [ "${e_neg:-0}" -lt "$neg" ] || [ "${e127:-0}" -lt "$n127" ] || [ "${e126:-0}" -lt "$n126" ]; then runs=1; fi; '
    + '      if [ $((n126 + n127)) -gt 0 ] && [ "${streak:-0}" -gt "$total" ]; then runs=1; fi; '
    + '      if [ "$state" = "running" ] && [ "$total" -gt 0 ] && [ "$runs" = "0" ]; then '
    + '        echo "WARNING: $job health check cannot run in its image (command not found or not executable), proceeding because the container is running"; exit 0; '
    + '      fi; '
    + '    fi; '
    + '    if [ "$health" = "unhealthy" ]; then '
    + '      if [ -z "$bad_since" ]; then bad_since="$i"; echo "$job health check is failing; waiting up to ${grace}s for it to recover"; fi; '
    + '    else '
    + '      bad_since=""; '
    + '    fi; '
    + '  fi; '
    + '  sleep 1; '
    + 'done; '
    + 'if [ -n "$bad_since" ]; then echo "ERROR: $job is unhealthy: its health check still failed ${grace}s after it first failed"; exit 1; fi; '
    + 'echo "ERROR: timed out waiting for $job to become healthy (waited ${max_polls}s)"; exit 1'
)


def _calculate_healthy_timeout_seconds(manifest):
    """Calculate the maximum seconds to wait for a service to become healthy based on its healthCheck (#3061)."""
    base = 120
    if not manifest or type(manifest) != 'dict':
        return base
    hc = manifest.get('healthCheck', {})
    if type(hc) != 'dict':
        return base
    start_period = hc.get('startPeriod', 0) or 0
    interval = hc.get('interval', 10) or 10
    retries = hc.get('retries', 3) or 3
    timeout = hc.get('timeout', 5) or 5
    calculated = start_period + (retries * (interval + timeout)) + 30
    if calculated > base:
        return calculated
    return base


def _register_healthy_resource(config, resource_path, compose_project_name, auto_init_apps=True):
    """`<res>-healthy`: waits until a service's container is healthy (#3061).

    Tilt counts a Compose resource as ready once its container starts running, which allows
    dependents with `condition: "service_healthy"` to start before the dependency's health
    check has passed. This local_resource monitors the container's health status via Docker
    inspect until it reports 'healthy', failing fast if the container exits or dies. 'unhealthy' is not final: a database on
    its first start can outlast its start period and recover by itself, and this gate never reruns once it fails, so the
    dependents would stay blocked after it turned healthy (#3210). It fails only when the health check is still failing
    `grace` (120) seconds after Docker first reported it unhealthy; that window may extend past `max_polls`.
    A health check that cannot run at all says nothing about the app, so a running container proceeds with a warning, but only
    on evidence the probe itself gives: exec form (a Compose `test: [CMD, curl, ...]`) is exit -1 with Docker's "OCI runtime exec
    failed" output; shell form is exit 127 with "not found" or exit 126 with "permission denied" in the output, and the whole
    failing streak must still be inside Docker's five-entry probe log (an older real failure may have scrolled out of it).
    Example: `curl` in an image without curl, as in LycheeOrg/Lychee's facial-recognition sidecar. A probe that runs and fails
    (any other exit code, or 127 without that message) still blocks dependents.
    If no healthcheck is configured, it proceeds as soon as the container is running.
    """
    timeout_s = _calculate_healthy_timeout_seconds(config.get('manifest', {}))
    argv = ['sh', '-c', _HEALTHY_SCRIPT, 'sh', config['res_name'], str(timeout_s)]
    argv.extend(_compose_project_argv(config, resource_path, compose_project_name))
    local_resource(
        name=job_healthy_resource_name(config['res_name']),
        cmd=argv,
        cmd_bat=POWERSHELL + [healthy_script()],
        env={'FLISK_JOB': config['res_name'], 'FLISK_MAX_POLLS': str(timeout_s), 'FLISK_COMPOSE': encode_json(_compose_project_argv(config, resource_path, compose_project_name)[1:])},
        labels=config['labels'] + ['health'],
        resource_deps=[config['res_name']],
        auto_init=auto_init_apps,
        allow_parallel=True,
    )


_JOB_DONE_SCRIPT = (
    'job="$1"; shift; '
    + 'if [ "$#" -gt 0 ]; then '
    + '  id="$("$@" ps -a -q "$job" 2>/dev/null | head -n 1)"; '
    + 'else '
    + '  id="$(docker ps -a -q -f "name=^/${job}$" 2>/dev/null | head -n 1)"; '
    + 'fi; '
    + 'if [ -z "$id" ]; then echo "no container for $job"; exit 1; fi; '
    + 'code="$(docker wait "$id")"; '
    + 'if [ "$code" != "0" ]; then rm -f ".flisk/outputs/$job.env" 2>/dev/null; echo "$job exited with code $code"; exit 1; fi; '
    + 'mkdir -p .flisk/outputs && chmod 700 .flisk/outputs 2>/dev/null || true; '
    + 'docker cp "$id":/tmp/flisk-output.env ".flisk/outputs/$job.env" 2>/dev/null && chmod 600 ".flisk/outputs/$job.env" 2>/dev/null || true; '
    + 'echo "$job finished (exit code 0)"'
)


def _register_job_done_resource(config, resource_path, compose_project_name, auto_init_apps=True):
    """`<job>-done`: waits until a one-shot job's container has exited, and fails unless it exited 0 (#2871).

    Tilt counts a Compose resource as ready once its container runs, so a service that depends on a migrator used to start
    while the migration was still running. Services that depend on the job wait for this resource too (_build_resource_deps).
    `docker compose wait` finds no container once a quick job has already exited, so this looks the container up (an exited
    one too) and runs `docker wait` on it, which returns the exit code at once when the job has finished. The job name and
    the compose argv are passed as arguments, never spliced into the script.
    """
    argv = ['sh', '-c', _JOB_DONE_SCRIPT, 'sh', config['res_name']]
    argv.extend(_compose_project_argv(config, resource_path, compose_project_name))
    local_resource(
        name=job_done_resource_name(config['res_name']),
        cmd=argv,
        cmd_bat=POWERSHELL + [job_done_script()],
        env={'FLISK_JOB': config['res_name'], 'FLISK_COMPOSE': encode_json(_compose_project_argv(config, resource_path, compose_project_name)[1:])},
        labels=config['labels'] + ['job'],
        resource_deps=[config['res_name']],
        auto_init=auto_init_apps,
        allow_parallel=True,
    )


HEALTHY_SCRIPT = _HEALTHY_SCRIPT
JOB_DONE_SCRIPT = _JOB_DONE_SCRIPT
register_healthy_resource = _register_healthy_resource
register_job_done_resource = _register_job_done_resource


def _register_dc_resources(resource_configs, resource_path, compose_project_name, auto_init_apps):
    """Register all dc_resources for the service."""
    for config in resource_configs:
        _register_single_resource(config, resource_path, compose_project_name, auto_init_apps)


# appTypes whose containers get DATABASE_URL and therefore need their logical database provisioned. Bring-your-own
# containers receive DATABASE_URL too (docs/byo.md), so without provisioning they point at a database that never exists.
# A migrator's whole job is that database.
DATABASE_APP_TYPES = ['backend', 'bring-your-own', 'migrator']


def resource_needs_database(manifest):
    """True when a resource of this manifest receives DATABASE_URL and needs its database provisioned."""
    manifest = manifest or {}
    if manifest.get('appType') in DATABASE_APP_TYPES:
        return True
    # An agent with postgres durability keeps its session checkpoints in the stack database, so without provisioning
    # its /ready never turns 200.
    agent = manifest.get('agent')
    return manifest.get('appType') == 'agent' and type(agent) == 'dict' and agent.get('durability') == 'postgres'


def _has_backend_resource(resource_config, resource_manifests):
    """Check if service has a resource that needs the provisioned database (backend or bring-your-own)."""
    for resource in resource_config.get('resources', []):
        manifest = resource_manifests.get(resource['name'], {})
        if resource_needs_database(manifest):
            return True
    return False


def _should_skip_frontend(res, should_enable):
    """Check if frontend resource should be skipped (backends-only mode)."""
    return res.get('frontend', False) and should_enable('backends-only')


def _register_frontend_typecheck(res, service_dir, typecheck_cmd):
    """Non-blocking `<service>-typecheck` resource: runs the planned tsc command so type errors show in Tilt without gating the image.

    The command runs on the host, so TypeScript must resolve from the service directory (`bun install`, at the
    service or workspace root). Without it the resource fails with that instruction instead of a bare module error.
    """
    local_resource(
        name=res['name'] + '-typecheck',
        # Fixed script, variable parts passed as argv ($1 = service dir, $2 = typecheck command), never spliced into the shell text.
        cmd=[
            'sh', '-c',
            'cd "$1" && { bunx tsc --version >/dev/null 2>&1 && test -f "$1/node_modules/vite/package.json" || { echo "typecheck needs host dependencies: run bun install in $1"; exit 1; }; } && eval "$2"',
            'sh', service_dir, typecheck_cmd,
        ],
        cmd_bat=POWERSHELL + [typecheck_script()],
        env={'FLISK_SERVICE_DIR': service_dir, 'FLISK_TYPECHECK': typecheck_cmd},
        deps=[service_dir + '/src', service_dir + '/tsconfig.json'],
        labels=['app.' + res['name'], 'typecheck'],
        # tsc --noEmit writes no files, so it can run alongside the image builds.
        allow_parallel=True,
    )


def _process_frontend_resource(res, manifest, full_res_path, resource_path, resource_name, should_enable, project_root=''):
    """Process a frontend resource and return compose entry."""
    target_path = res.get('target_path', manifest.get('target_path', '/usr/share/nginx/html'))
    use_nginx = 'nginx' in target_path or target_path == '/usr/share/nginx/html'
    port = res.get('port', manifest.get('port', BASE_PORT_FRONTEND))
    service_dir = (project_root.rstrip('/') + '/' if project_root else '') + full_res_path
    plan = frontend_build_plan(service_dir + '/package.json')
    Docker.frontend(
        res_path=full_res_path,
        resource_name=res['name'],
        port=port,
        target_path=target_path,
        use_nginx=use_nginx,
        use_golden=should_enable('golden-image'),
        build_cmd=plan['build_cmd'],
    )
    if plan['typecheck']:
        _register_frontend_typecheck(res, service_dir, plan['typecheck_cmd'])
    return Docker.frontend_compose(resource_path=resource_path, resource_name=resource_name, res=res, manifest=manifest)


def _process_backend_resource(res, manifest, full_res_path, resource_path, resource_name, should_enable):
    """Process a backend resource and return compose entry."""
    if manifest.get('appType') != 'bring-your-own':
        Docker.backend(
            res_path=full_res_path,
            resource_name=res['name'],
            port=None,  # Use default BASE_PORT_BACKEND
            build_cmd=res.get('start_command', 'bun run build'),
            use_golden=should_enable('golden-image'),
        )
    return Docker.backend_compose(resource_path=resource_path, resource_name=resource_name, res=res, manifest=manifest)


def _build_resource_config(res, manifest, resource_config, full_res_path, infra_deps,
                          config_gen_resources, resource_manifests, runtime_flags, all_services_map=None, project_root=''):
    """Build configuration dict for a single resource."""
    res_name = res['name']
    res_deps = _build_resource_deps(
        res, res_name, manifest, resource_config, infra_deps,
        config_gen_resources, resource_manifests, runtime_flags, all_services_map,
    )
    replicas = manifest.get('replicas', 1)
    if runtime_flags['disable_app_replicas']:
        replicas = 1

    # Extract environment variables from manifest params
    env_vars = manifest.get('params', {})

    return {
        'res_name': res_name,
        'resource_name': resource_config['name'],
        'res_deps': res_deps,
        'labels': ['app.' + res_name],
        'replicas': replicas,
        'syncs': res.get('syncs', []),
        'app_type': manifest.get('appType', 'backend'),
        'dockerfile': res.get('dockerfile', manifest.get('dockerfile', OUTPUT.AUTOGENERATED_FOLDER + '/Dockerfile.app.autogenerated')),
        'res_path': full_res_path,
        'env': env_vars,
        'project_root': project_root,
        'manifest': manifest,
        'all_services': all_services_map or {},
    }


def count_routable_backends_by_stack(resource_config, resource_manifests, default_stack):
    """Count the backends of each stack that get a Traefik route (workers, migrators, frontends, SDKs, libraries, unproxied BYO and BYO web UIs do not)."""
    counts = {}
    for resource in resource_config.get('resources', []):
        manifest = resource_manifests.get(resource['name'], {})
        app_type = manifest.get('appType', 'backend')
        if resource.get('frontend', False) or app_type in ['frontend', 'worker', 'migrator', 'library', 'sdk', 'infra', 'database']:
            continue
        if app_type == 'bring-your-own' and not manifest.get('exposeViaProxy', True):
            continue
        # A web UI has its own host name and no stack-scoped router (#2997), so it shares nothing with the stack's backends.
        if app_type == 'bring-your-own' and manifest.get('webUi') == True:
            continue
        stack = manifest.get('stack', default_stack)
        counts[stack] = counts.get(stack, 0) + 1
    return counts


def register_compose_resources(resource_config, ctx, runtime_flags, manifest_state):
    """Register all compose resources for a service."""
    resource_name = resource_config.get('name', '')
    resource_path = resource_config.get('path', '')
    
    debug_log("COMPOSE: register_compose_resources called for '{}' path='{}'".format(resource_name, resource_path))
    
    if not resource_name:
        print("⚠️  Skipping service without name")
        return {'compose_project_name': ''}
    
    if not resource_path:
        # Silently skip services without paths - these may be library references
        # or incomplete manifests
        debug_log("COMPOSE: SKIPPING '{}' - no path".format(resource_name))
        return {'compose_project_name': ''}
    
    debug_log("COMPOSE: Proceeding with '{}' - creating compose resources".format(resource_name))
    should_enable = ctx['should_enable']
    write_file = ctx['write_file']
    compose_project_name = PlatformDockerConstants.compose_project_name(resource_name)
    
    resource_manifests = manifest_state['resource_manifests']
    config_gen_resources = manifest_state['config_gen_resources']
    has_backend = _has_backend_resource(resource_config, resource_manifests)
    # Build map of all services for dependency resolution
    # This maps short names like 'identity' to full resource names
    all_services_map = _build_all_services_map(ctx.get('all_services', []))
    infra_deps = _build_infra_dependencies(
        resource_name, should_enable, ctx, has_backend,
        uses_golden_image=_stack_waits_for_golden_step(resource_config, resource_manifests, all_services_map),
    )
    if not ctx.get('_dependency_cycle_checked', False):
        ctx['_dependency_cycle_checked'] = True
        _fail_on_dependency_cycle(all_services_map)

    # Selection-bound shared platform Postgres start signal.
    # Only enabled resources in THIS stack are evaluated. Registration sees
    # unselected siblings before Tilt's enabled-resource filter runs.
    # When database-management is off and any selected resource is a `database`
    # resource or depends on postgres/database-management/a database resource, force-start the shared
    # platform Postgres via the existing infra loader (materializes
    # services/platform/database-management/docker-compose.yml + registers the
    # existing `postgres` Tilt resource). Does NOT open migrators/provision-db/Prisma.
    # Idempotent across services: force_start_shared_platform_postgres_once
    # guards on ctx so two selected dependents do not register postgres twice.
    # A stack whose own Compose file already declares a `postgres` service (e.g. Ghostfolio, imported from its docker-compose.yml)
    # gets that service as its `postgres` dependency. Force-starting the shared platform Postgres would register a second
    # `postgres` dc_resource and fail Tilt with "dc_resource named postgres already exists".
    stack_declares_postgres = compose_files_declare_service(resource_config, ctx, 'postgres') or stack_has_own_postgres_container(resource_config, resource_manifests)
    if stack_declares_postgres:
        # provision-db-* resources target the shared platform Postgres, which is not registered here.
        infra_deps = [dep for dep in infra_deps if not dep.startswith('provision-db-')]
    if not should_enable('database-management') and not stack_declares_postgres:
        database_names = database_resource_names(all_services_map)
        for res in resource_config.get('resources', []):
            if not selected_for_shared_platform_postgres(res.get('name', ''), ctx):
                continue
            res_manifest = resource_manifests.get(res['name'], {})
            if manifest_needs_shared_platform_postgres(res_manifest, database_names):
                debug_log("COMPOSE: selected '{}' dependsOn shared platform Postgres; force-starting postgres".format(res.get('name', '')))
                force_start_shared_platform_postgres_once(ctx, should_enable, res.get('name', ''))
                break

    resource_entries = []
    resource_configs = []
    stack_backend_counts = count_routable_backends_by_stack(resource_config, resource_manifests, resource_name)

    for res in resource_config.get('resources', []):
        if _should_skip_frontend(res, should_enable):
            continue
        
        full_res_path = res.get('_resource_path', resource_path + '/' + res['name'])
        manifest = resource_manifests.get(res['name'], {})
        if manifest:
            # Tell the Traefik label generator how many routable backends share this stack (see _stack_is_shared in networking/traefik.star).
            manifest = dict(manifest)
            manifest['_stackBackendCount'] = stack_backend_counts.get(manifest.get('stack', resource_name), 1)
            # A bring-your-own container gets the shared database variables only when it asks for them (#2991).
            # A `databaseName` discovery computed for every service is not a request; one the service wrote itself is.
            wrote_database_name = bool(manifest.get('databaseName')) and not manifest.get('_databaseNameComputed')
            # `dependsOn: postgres` is no such request when the project imported its own `postgres`: the shared one is not registered.
            depends_on_shared = manifest_needs_shared_platform_postgres(manifest, database_resource_names(all_services_map)) and not project_imports_own_postgres_container(all_services_map)
            manifest['_sharedDatabase'] = depends_on_shared or wrote_database_name
        
        # Skip non-app resources - they don't use the golden app Dockerfile pipeline.
        # infra (e.g. verdaccio) is loaded via registries/verdaccio_loader.star instead.
        # Building verdaccio as a backend produced broken COPY paths and missing package.json.
        app_type = manifest.get('appType', 'backend')
        # A `database` resource is the shared platform Postgres (registered by the infra loader as `postgres`), not a container of its own.
        if app_type in ['library', 'sdk', 'infra', 'database']:
            debug_log("COMPOSE: Skipping '{}' appType='{}' (not an app container)".format(res.get('name', ''), app_type))
            continue
        
        if res.get('frontend', False):
            entry = _process_frontend_resource(res, manifest, full_res_path, resource_path, resource_name, should_enable, ctx.get('project_root', ''))
        else:
            entry = _process_backend_resource(res, manifest, full_res_path, resource_path, resource_name, should_enable)
            # A deferStart resource has no container Traefik can discover via
            # labels until its first request creates one (D2/D4) -- give it a
            # static file-provider route instead, pointed at the wake gateway.
            # Scoped to backends for now, matching the proposal's motivating
            # case; frontend support is a natural follow-up, not implemented
            # here. Dependency waking (D5): Flisk's real infra dependencies
            # (database, NATS, a resource's own migrator) live in
            # separately-registered compose files that `depends_on` cannot
            # reference (confirmed empirically, see design.md D5), and they're
            # always-on infra that's essentially never actually cold, so they
            # never show up here regardless. The one real case D5 flags as
            # mattering -- a peer resource that is itself deferStart -- is
            # resolved via the manifest's own `dependsOn` below.
            if resource_defers_start(manifest) and write_file:
                internal_port = res.get('port', manifest.get('port', BASE_PORT_BACKEND))
                static_route_path = PlatformDockerConstants.TRAEFIK_DYNAMIC_DIR_REL + '/' + res['name'] + '.yml'
                compose_invocation = _wake_compose_invocation(
                    ctx.get('project_root', ''), resource_path, res['name'], resource_name,
                ) or {}
                write_file(static_route_path, generate_static_wake_route(
                    resource_entry_name=res['name'],
                    compose_project_name=compose_project_name,
                    manifest=manifest,
                    internal_port=internal_port,
                    gateway_host=PlatformDockerConstants.TRAEFIK_WAKE_GATEWAY_CONTAINER,
                    gateway_port=PlatformDockerConstants.TRAEFIK_WAKE_GATEWAY_PORT,
                    dependencies=resolve_defer_start_dependencies(manifest, resource_manifests, all_services_map),
                    compose_files=compose_invocation.get('compose_files'),
                    env_file=compose_invocation.get('env_file', ''),
                    image=compose_invocation.get('image', ''),
                ))

        resource_entries.append(entry)
        built_config = _build_resource_config(
            res, manifest, resource_config, full_res_path, infra_deps,
            config_gen_resources, resource_manifests, runtime_flags, all_services_map,
            ctx.get('project_root', ''),
        )
        # A focused run still registers disabled siblings before Tilt applies
        # set_enabled_resources. Do not leave their edge pointing at a Postgres
        # resource that this evaluation did not register.
        if not should_enable('database-management') and not stack_declares_postgres and not ctx.get('_shared_platform_postgres_force_started', False):
            built_config['res_deps'] = [dep for dep in built_config['res_deps'] if dep != 'postgres']
        resource_configs.append(built_config)

    debug_log("COMPOSE: Calling Docker.app_compose for '{}' with write_fn={}".format(resource_name, write_file))
    Docker.app_compose(resource_path, resource_entries, write_file)
    
    debug_log("COMPOSE: {} resource_entries count = {}".format(resource_name, len(resource_entries)))
    
    # Prepend project root to make path absolute from project root
    project_root = ctx.get('project_root', '')
    
    # Only register docker_compose if we have actual services (not just libraries)
    if resource_entries:
        compose_file_rel = resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/docker-compose.app.autogenerated.yml'
        compose_file = project_root + '/' + compose_file_rel if project_root else compose_file_rel
        # The env file of the run for docker-compose variables (DB_PASSWORD, etc.): the project .env,
        # or the file `flisk up --env-file` selected.
        env_file = project_env_file(project_root)
        debug_log("COMPOSE: Calling docker_compose for '{}' with {} env_file={}".format(resource_name, compose_file, env_file))
        _docker_compose_app(compose_file, compose_project_name, env_file)
        port_override_rel = resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/docker-compose.port-override.yml'
        port_override = project_root + '/' + port_override_rel if project_root else port_override_rel
        if file_exists(port_override):
            debug_log("COMPOSE: Applying port override {}".format(port_override))
            _docker_compose_app(port_override, compose_project_name, env_file)
    else:
        debug_log("COMPOSE: SKIPPING docker_compose for '{}' - no resource_entries".format(resource_name))

    for compose_file in resource_config.get('compose_files', []):
        if compose_file != '.autogenerated/docker-compose.app.autogenerated.yml':
            compose_file_full = project_root + '/' + resource_path + '/' + compose_file if project_root else resource_path + '/' + compose_file
            env_file = project_env_file(project_root)
            _docker_compose_app(compose_file_full, compose_project_name, env_file)

    debug_log("COMPOSE: Calling _register_dc_resources for '{}' with {} configs, auto_init={}".format(resource_name, len(resource_configs), runtime_flags['auto_init_apps']))
    _register_dc_resources(resource_configs, resource_path, compose_project_name, runtime_flags['auto_init_apps'])

    return {'compose_project_name': compose_project_name}


ComposeResourceRegistration = struct(
    register = register_compose_resources,
)

DEBUG = {}
