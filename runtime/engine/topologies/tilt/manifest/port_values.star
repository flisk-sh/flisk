# A manifest's "port": "auto" is a run-time value (#4683). Generated files keep a deterministic Compose/Tilt
# interpolation placeholder, so a resolved port never appears in service.json, .flisk/.flisk-out or .autogenerated.


def _env_name(name):
    result = ''
    for char in name:
        if ('a' <= char and char <= 'z') or ('A' <= char and char <= 'Z') or ('0' <= char and char <= '9'):
            result += char.upper()
        else:
            result += '_'
    return 'FLISK_SERVICE_' + result + '_PORT'


def manifest_port(manifest, default, resource_name=None):
    """The port a generator writes: the fixed number, or ${FLISK_SERVICE_<NAME>_PORT:-default} for "auto"."""
    value = manifest.get('port') if manifest else None
    if value == 'auto':
        name = resource_name or (manifest.get('appName') if manifest else None) or 'service'
        return '${' + _env_name(name) + ':-' + str(default) + '}'
    return value if value != None else default


def manifest_port_number(manifest, default):
    """A deterministic numeric port for files Compose cannot interpolate (Vite, nginx, health scripts)."""
    value = manifest.get('port') if manifest else None
    return default if value == 'auto' or value == None else value
