    # =========================================================================
    
    # File loading functions
    load_from_file=ManifestLoader.load_from_file,
    load_from_path=ManifestLoader.load_from_path,
    load_all=ManifestLoader.load_all,
    
    # Cache management
    clear_cache=ManifestLoader.clear_cache,
    get_cache_stats=ManifestLoader.get_cache_stats,
    is_cached=ManifestLoader.is_cached,
    
    # Path utilities
    get_manifest_path=ManifestLoader.get_manifest_path,
    
    # =========================================================================
    # Parsing and Normalization
