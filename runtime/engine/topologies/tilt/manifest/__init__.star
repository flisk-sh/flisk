    extract_stack=ManifestParser.extract_stack,
    
    # Config parsing
    parse_traefik=ManifestParser.parse_traefik,
    
    # Manifest utilities
    merge_manifests=ManifestParser.merge,
    get_description=ManifestParser.get_description,
    
    # =========================================================================
    # Validation ⭐ NEW (Phase 3)
    # =========================================================================
    
    # Main validation
    validate=ManifestValidator.validate,
    is_valid=ManifestValidator.is_valid,
    get_validation_report=ManifestValidator.get_report,
    
    # Specific validation levels
    validate_schema=ManifestValidator.validate_schema,
    validate_values=ManifestValidator.validate_values,
    validate_dependencies=ManifestValidator.validate_dependencies,
    
    # =========================================================================
