{
  "name": "@flisk-sh/flisk",
  "version": "1.4.51",
  "mcpName": "io.github.flisk-sh/flisk",
  "description": "Flisk: local development for multi-service apps, started with one command.",
  "homepage": "https://flisk.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flisk-sh/flisk.git"
  },
  "bugs": {
    "url": "https://github.com/flisk-sh/flisk/issues"
  },
  "private": false,
  "type": "module",
  "main": "./cli/dist/types/index.js",
  "workspaces": [
    "cli"
  ],
  "bin": {
    "flisk": "cli/bin/flisk.js"
  },
  "files": [
    "runtime",
    "!runtime/engine/docs",
    "!runtime/ext/ide-components/code_executor",
    "!runtime/**/__tests__/**",
    "!runtime/**/tests/**",
    "!runtime/**/*.test.*",
    "!runtime/**/*.spec.*",
    "!runtime/**/test_*.py",
    "!runtime/**/*_test.py",
    "examples/flisk-example",
    "cli/bin",
    "cli/dist-bundle/**/*.js",
    "cli/dist-bundle/build-info.json",
    "cli/dist/types/index.js",
    "cli/dist/utils/constants.js",
    "cli/templates",
    "cli/package.json",
    "cli/shared-platform-engineering/docker-templates",
    "docs/CHANGELOG.md"
  ],
  "scripts": {
    "build": "cd cli && npm run build",
    "build:watch": "cd cli && npm run build:watch",
    "typecheck": "cd cli && npm run typecheck",
    "lint": "cd cli && npm run lint",
    "lint:fix": "cd cli && npm run lint:fix",
    "check": "npm run lint && npm run typecheck",
    "test": "cd cli && npm run test",
    "clean": "cd cli && npm run clean",
    "test:scripts": "node --test 'scripts/**/*.test.mjs' 'cli/scripts/**/*.test.mjs' 'tests/e2e/lib/**/*.test.mjs' 'tests/e2e/journeys/night-city/project/lib/*.test.mjs' 'tests/oracle/**/*.test.mjs' 'tests/falsifier/**/*.test.mjs' 'tests/mutation/**/*.test.mjs'",
    "check:shell": "scripts/check-shell.sh",
    "check:static": "node tests/e2e/lib/validate-suites.mjs && bash tests/e2e/static/skills-and-docs.sh >/dev/null && node scripts/check-ci-inventory.mjs && node scripts/scores/run.mjs --check && node scripts/competitor-matrix.mjs --check && node tests/e2e/lib/check-axes.mjs",
    "release:binaries": "scripts/release-binaries.sh",
    "release:binaries:publish": "scripts/release-binaries.sh --publish",
    "prepack": "node cli/scripts/bundle.mjs",
    "postpack": "rm -rf cli/dist-bundle",
    "prepare": "scripts/install-git-hooks.sh",
    "cli": "cd cli && node bin/flisk.js",
    "flisk": "cd cli && node bin/flisk.js"
  },
  "keywords": [
    "flisk",
    "tilt",
    "cli",
    "microservices",
    "local-dev",
    "local-development",
    "developer-tools",
    "developer-experience",
    "docker",
    "docker-compose",
    "dev-environment",
    "monorepo",
    "hot-reload",
    "bun",
    "kubernetes-alternative",
    "docker-compose-alternative",
    "live-reload",
    "no-kubernetes",
    "service-orchestration",
    "tiltfile"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "chalk": "^6.0.1",
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "@types/node": "^26.6.5",
    "knip": "^6.38.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "knip": {
    "workspaces": {
      "cli": {
        "entry": [
          "src/cli.ts"
        ],
        "project": [
          "src/**/*.ts",
          "src/**/*.tsx"
        ],
        "ignoreBinaries": [
          "vi",
          "colima",
          "podman",
          "killall",
          "file",
          "flisk",
          "tilt"
        ]
      }
    }
  }
}
