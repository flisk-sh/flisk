{
  "id": "flisk-kiri",
  "name": "Flisk on Kiri (images built on Docker)",
  "optIn": true,
  "tool": {
    "name": "flisk",
    "version": "${FLISK_CMD:-flisk} --version | tail -1"
  },
  "requires": [
    "docker",
    "tilt",
    "kiri"
  ],
  "env": {
    "FLISK_HTTP_PORT": "${BENCH_PORT}",
    "FLISK_HTTPS_PORT": "${BENCH_PORT2}",
    "FLISK_POSTGRES_PORT": "${BENCH_PORT3}",
    "TILT_PORT": "${BENCH_PORT4}"
  },
  "setup": "sh setup.sh",
  "start": "K=$(docker context inspect kiri --format '{{.Endpoints.docker.Host}}'); (sleep 660; echo \"=== kiri diagnostics ===\"; DOCKER_HOST=$K docker inspect flisk_kiri_traefik --format \"{{json .Mounts}} {{json .NetworkSettings.Networks}}\"; DOCKER_HOST=$K docker inspect flisk-kiri-shop-autogenerated-storefront-1 --format \"{{json .Config.Labels}} {{json .NetworkSettings.Networks}}\"; DOCKER_HOST=$K docker ps -a --format \"{{.Names}} {{.Status}} {{.Ports}}\"; DOCKER_HOST=$K docker logs --tail 40 flisk_kiri_traefik 2>&1; DOCKER_HOST=$K docker network ls; curl -s -m 5 -o /dev/null -w \"traefik app: %{http_code}\\n\" -H \"Host: app.flisk-kiri.localhost\" http://127.0.0.1:${BENCH_PORT}/) & mkdir -p shim && cp \"$BENCH_SHOP/../competitors/flisk-kiri/docker-shim.sh\" shim/docker 2>/dev/null; SHIM_REAL_DOCKER=$(command -v docker) SHIM_KIRI_HOST=$K FLISK_DOCKER_SOCKET=/run/kiri/docker.sock PATH=\"$PWD/shim:$PATH\" DOCKER_HOST=$K ${FLISK_CMD:-flisk} up shop",
  "stop": "DOCKER_HOST=$(docker context inspect kiri --format '{{.Endpoints.docker.Host}}') ${FLISK_CMD:-flisk} down",
  "purge": "DOCKER_HOST=$(docker context inspect kiri --format '{{.Endpoints.docker.Host}}') ${FLISK_CMD:-flisk} down --purge --prune-networks",
  "clean": "DOCKER_HOST=$(docker context inspect kiri --format '{{.Endpoints.docker.Host}}') ${FLISK_CMD:-flisk} down --prune-networks",
  "timeoutSeconds": 900,
  "base": "http://app.flisk-kiri.localhost:${BENCH_PORT}",
  "paths": {
    "products": "http://api.flisk-kiri.localhost:${BENCH_PORT}/api/catalog/api/products",
    "orders": "http://api.flisk-kiri.localhost:${BENCH_PORT}/api/orders/api/orders",
    "payments": "http://api.flisk-kiri.localhost:${BENCH_PORT}/api/payments/api/payments",
    "notifications": "http://api.flisk-kiri.localhost:${BENCH_PORT}/api/notifications/api/notifications",
    "storefront": "/",
    "admin": "/admin"
  },
  "health": [
    "http://app.flisk-kiri.localhost:${BENCH_PORT}/",
    "http://app.flisk-kiri.localhost:${BENCH_PORT}/admin",
    "http://api.flisk-kiri.localhost:${BENCH_PORT}/api/catalog/health",
    "http://api.flisk-kiri.localhost:${BENCH_PORT}/api/orders/health",
    "http://api.flisk-kiri.localhost:${BENCH_PORT}/api/payments/health",
    "http://api.flisk-kiri.localhost:${BENCH_PORT}/api/notifications/health"
  ],
  "milestones": [
    {
      "name": "flisk checks done, engine started",
      "match": "^Running tilt up"
    },
    {
      "name": "engine read the project",
      "match": "Successfully loaded Tiltfile"
    },
    {
      "name": "database ready",
      "match": "^postgres: ready \\("
    },
    {
      "name": "migrations done",
      "match": "^migrator-done: ready \\("
    },
    {
      "name": "last image built",
      "match": "^[\\w-]+-image: ready \\(",
      "pick": "last"
    }
  ],
  "wiring": {
    "configFiles": [
      "services/**/service.json"
    ],
    "waitsOnHealthy": "\"dependsOn\"",
    "healthChecks": "healthCheck"
  }
}
