{
  "id": "flisk",
  "name": "Flisk",
  "tool": { "name": "flisk", "version": "${FLISK_CMD:-flisk} --version | tail -1" },
  "requires": ["docker", "tilt"],
  "env": {
    "FLISK_HTTP_PORT": "${BENCH_PORT}",
    "FLISK_HTTPS_PORT": "${BENCH_PORT2}",
    "FLISK_POSTGRES_PORT": "${BENCH_PORT3}",
    "TILT_PORT": "${BENCH_PORT4}"
  },
  "setup": "sh setup.sh",
  "start": "${FLISK_CMD:-flisk} up shop",
  "stop": "${FLISK_CMD:-flisk} down",
  "purge": "${FLISK_CMD:-flisk} down --purge --prune-networks",
  "clean": "${FLISK_CMD:-flisk} down --prune-networks",
  "timeoutSeconds": 1500,
  "base": "http://flisk.localhost:${BENCH_PORT}",
  "paths": {
    "products": "http://api.flisk.localhost:${BENCH_PORT}/api/catalog/api/products",
    "orders": "http://api.flisk.localhost:${BENCH_PORT}/api/orders/api/orders",
    "payments": "http://api.flisk.localhost:${BENCH_PORT}/api/payments/api/payments",
    "notifications": "http://api.flisk.localhost:${BENCH_PORT}/api/notifications/api/notifications",
    "storefront": "/",
    "admin": "/admin/"
  },
  "health": [
    "http://flisk.localhost:${BENCH_PORT}/",
    "http://flisk.localhost:${BENCH_PORT}/admin/",
    "http://api.flisk.localhost:${BENCH_PORT}/api/catalog/health",
    "http://api.flisk.localhost:${BENCH_PORT}/api/orders/health",
    "http://api.flisk.localhost:${BENCH_PORT}/api/payments/health",
    "http://api.flisk.localhost:${BENCH_PORT}/api/notifications/health"
  ],
  "wiring": { "configFiles": ["services/**/service.json"], "waitsOnHealthy": "\"dependsOn\"", "healthChecks": "healthCheck" }
}
