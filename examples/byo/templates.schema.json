{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bring-your-own template registry (examples/byo/templates.json)",
  "type": "object",
  "required": ["templates"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "folder", "repository", "tag", "port", "healthCheckPath"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "folder": { "type": "string", "pattern": "^create-[a-z0-9-]+$" },
          "repository": { "type": "string", "pattern": "^flisk-sh/flisk-template-[a-z0-9-]+$" },
          "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "healthCheckPath": { "type": "string", "pattern": "^/" },
          "upstream": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    }
  }
}
